#!/usr/bin/env bash
set -euo pipefail

# torque-push wraps main pushes so same-commit concurrent gates coalesce before
# Git negotiates a remote ref transaction. A pre-push hook cannot repair that
# race after Git has already read the remote's old SHA.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

local_ref_for_main_push() {
  local args=("$@")
  local positional=()
  local skip_next=0
  local arg branch upstream remote refspec source target main_ref_count

  if [ "${#args[@]}" -eq 0 ]; then
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    if [ "$branch" = "main" ] && [ "$upstream" = "origin/main" ]; then
      printf '%s\n' "HEAD"
      return 0
    fi
    return 1
  fi

  for arg in "${args[@]}"; do
    if [ "$skip_next" -eq 1 ]; then
      skip_next=0
      continue
    fi
    case "$arg" in
      --all|--mirror|--tags|--delete|-d)
        return 1
        ;;
      --repo|--receive-pack|--exec|--push-option|-o)
        skip_next=1
        ;;
      --repo=*|--receive-pack=*|--exec=*|--push-option=*)
        ;;
      --*)
        ;;
      -*)
        ;;
      *)
        positional+=("$arg")
        ;;
    esac
  done

  if [ "${#positional[@]}" -lt 2 ]; then
    return 1
  fi

  remote="${positional[0]}"
  if [ "$remote" != "origin" ]; then
    return 1
  fi

  source=""
  main_ref_count=0
  for refspec in "${positional[@]:1}"; do
    case "$refspec" in
      :*)
        return 1
        ;;
    esac

    if [[ "$refspec" == *:* ]]; then
      source="${refspec%%:*}"
      target="${refspec#*:}"
    else
      source="$refspec"
      target="$refspec"
    fi
    source="${source#+}"

    case "$target" in
      main|refs/heads/main)
        main_ref_count=$((main_ref_count + 1))
        ;;
      *)
        return 1
        ;;
    esac
  done

  if [ "$main_ref_count" -ne 1 ] || [ -z "$source" ]; then
    return 1
  fi

  printf '%s\n' "$source"
  return 0
}

remote_main_sha() {
  git ls-remote origin refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }'
}

origin_main_matches_local_head() {
  local current_remote_main
  current_remote_main="$(remote_main_sha || true)"
  [ -n "$current_remote_main" ] && [ "$current_remote_main" = "$local_head_sha" ]
}

resolve_local_head_sha() {
  git rev-parse "${local_ref}^{commit}"
}

set_local_head_sha() {
  local_head_sha="$(resolve_local_head_sha)"
  local_head_short="$(echo "$local_head_sha" | cut -c1-12)"
}

local_ref_matches_local_head() {
  local current_local_head
  current_local_head="$(resolve_local_head_sha 2>/dev/null || true)"
  [ -n "$current_local_head" ] && [ "$current_local_head" = "$local_head_sha" ]
}

refresh_if_local_ref_moved() {
  local current_local_head current_local_short
  current_local_head="$(resolve_local_head_sha 2>/dev/null || true)"
  if [ -z "$current_local_head" ] || [ "$current_local_head" = "$local_head_sha" ]; then
    return 1
  fi

  current_local_short="$(echo "$current_local_head" | cut -c1-12)"
  echo "[torque-push] local ref $local_ref moved from $local_head_short to $current_local_short while waiting; retrying from the new tip."
  local_head_sha="$current_local_head"
  local_head_short="$current_local_short"
  return 0
}

maybe_source_coord_lock() {
  local helper="${repo_root}/scripts/repo-coordination-lock.sh"
  if [ -f "$helper" ]; then
    # shellcheck source=/dev/null
    source "$helper"
  fi
}

wait_for_matching_pre_push_gate() {
  if ! declare -F repo_coord_lock_path >/dev/null 2>&1; then
    return 1
  fi

  local lock_dir owner_file expected_purpose owner_purpose wait_secs poll_secs notice_secs deadline now next_notice
  lock_dir="$(repo_coord_lock_path main)"
  if [ ! -d "$lock_dir" ]; then
    return 1
  fi

  owner_file="$lock_dir/owner.env"
  expected_purpose="pre-push main gate: $local_head_short"
  owner_purpose="$(repo_coord_lock_read_field "$owner_file" purpose)"
  if [ "$owner_purpose" != "$expected_purpose" ]; then
    return 1
  fi

  wait_secs="${TORQUE_PUSH_MATCHING_GATE_WAIT_SECS:-${PRE_PUSH_MATCHING_GATE_WAIT_SECS:-${TORQUE_COORD_LOCK_WAIT_SECS:-7200}}}"
  poll_secs="${TORQUE_PUSH_MATCHING_GATE_POLL_SECS:-${TORQUE_COORD_LOCK_POLL_SECS:-5}}"
  notice_secs="${TORQUE_PUSH_MATCHING_GATE_NOTICE_SECS:-${TORQUE_COORD_LOCK_NOTICE_SECS:-30}}"
  case "$wait_secs" in ''|*[!0-9]*) wait_secs=7200 ;; esac
  case "$poll_secs" in ''|*[!0-9]*) poll_secs=5 ;; esac
  case "$notice_secs" in ''|*[!0-9]*) notice_secs=30 ;; esac

  echo "[torque-push] Matching pre-push gate for $local_head_short is running; waiting before push negotiation."
  deadline=$(( $(date +%s) + wait_secs ))
  next_notice=0

  while [ -d "$lock_dir" ]; do
    if origin_main_matches_local_head; then
      if local_ref_matches_local_head; then
        echo "[torque-push] origin/main reached $local_head_short; no push needed."
        return 0
      fi
      echo "[torque-push] origin/main reached $local_head_short, but $local_ref moved while waiting."
      return 1
    fi
    if repo_coord_lock_reap_if_dead_owner "$lock_dir"; then
      echo "[torque-push] Previous matching gate owner is gone; running push normally."
      return 1
    fi
    if repo_coord_lock_reap_if_stale "$lock_dir"; then
      echo "[torque-push] Previous matching gate lease was stale; running push normally."
      return 1
    fi

    owner_file="$lock_dir/owner.env"
    owner_purpose="$(repo_coord_lock_read_field "$owner_file" purpose)"
    if [ "$owner_purpose" != "$expected_purpose" ]; then
      echo "[torque-push] Main gate lease changed owner; running push normally."
      return 1
    fi

    now="$(date +%s)"
    if [ "$now" -ge "$deadline" ]; then
      echo "[torque-push] Timed out waiting for matching pre-push gate; running push normally."
      return 1
    fi

    if [ "$now" -ge "$next_notice" ]; then
      echo "[torque-push] Waiting for active gate owner: $(repo_coord_lock_describe "$lock_dir")"
      next_notice=$((now + notice_secs))
    fi
    sleep "$poll_secs"
  done

  if origin_main_matches_local_head; then
    if local_ref_matches_local_head; then
      echo "[torque-push] origin/main reached $local_head_short; no push needed."
      return 0
    fi
    echo "[torque-push] origin/main reached $local_head_short, but $local_ref moved while waiting."
  fi
  return 1
}

local_ref="$(local_ref_for_main_push "$@" || true)"
if [ -z "$local_ref" ]; then
  exec git push "$@"
fi

maybe_source_coord_lock

max_ref_refreshes="${TORQUE_PUSH_REF_REFRESH_LIMIT:-8}"
case "$max_ref_refreshes" in ''|*[!0-9]*) max_ref_refreshes=8 ;; esac
ref_refreshes=0

while :; do
  set_local_head_sha

  if origin_main_matches_local_head; then
    echo "[torque-push] origin/main already at $local_head_short; no push needed."
    exit 0
  fi

  if wait_for_matching_pre_push_gate; then
    exit 0
  fi

  if refresh_if_local_ref_moved; then
    ref_refreshes=$((ref_refreshes + 1))
    if [ "$ref_refreshes" -gt "$max_ref_refreshes" ]; then
      echo "[torque-push] local ref $local_ref changed more than $max_ref_refreshes time(s) while pushing; stop the moving cutovers and retry."
      exit 1
    fi
    continue
  fi

  set +e
  git push "$@"
  push_rc=$?
  set -e

  if [ "$push_rc" -eq 0 ]; then
    exit 0
  fi

  if origin_main_matches_local_head; then
    if local_ref_matches_local_head; then
      echo "[torque-push] git push returned $push_rc, but origin/main is now at $local_head_short; treating as success."
      exit 0
    fi
    echo "[torque-push] git push returned $push_rc and origin/main reached $local_head_short, but $local_ref moved while waiting."
  fi

  if refresh_if_local_ref_moved; then
    ref_refreshes=$((ref_refreshes + 1))
    if [ "$ref_refreshes" -gt "$max_ref_refreshes" ]; then
      echo "[torque-push] local ref $local_ref changed more than $max_ref_refreshes time(s) while pushing; stop the moving cutovers and retry."
      exit 1
    fi
    continue
  fi

  exit "$push_rc"
done
