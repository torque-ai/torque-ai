#!/usr/bin/env bash
# Two-tier pre-push flow:
# - Pushes targeting refs/heads/main run the full dashboard + server gate.
# - The gate stages HEAD on a disposable `pre-push-gate/<sha>` ref so the remote
#   can sync and test *without* touching origin/main. On success, the outer
#   `git push` proceeds normally (fast-forward, no ref drift). On failure, the
#   staging ref is deleted and the push is blocked with exit 1.
# - If the disposable staging ref or remote worker path is unavailable, the hook
#   still runs the same gate in a detached local worktree at the pushed SHA.
# - Pushes that only update non-main refs skip tests so feature-branch iteration stays fast.
# - Delete-only pushes are always allowed and skipped from gating analysis.
# - When a branch is later merged or pushed to main, the full gate runs again there.
# - Use git push --no-verify as the escape hatch when bypassing the hook is intentional.
#
# Why staging-branch instead of pushing to origin/main up-front:
# - Previously the hook pushed HEAD to origin/main before testing (so torque-remote
#   could sync it), then rolled back on failure. That left the outer `git push`
#   to send a pack whose expected_sha no longer matched origin, producing a
#   confusing `[remote rejected] main -> main (cannot lock ref)` error and a
#   non-zero exit code even when the gate passed. Scripts doing `git push && …`
#   broke on the false failure. See project memory for the diagnosis.
# - Staging keeps origin/main immutable until the user's push lands. When a
#   concurrent hook already moved origin/main to this exact HEAD, this hook exits
#   with a controlled coalesced code instead of allowing Git to attempt a stale
#   ref transaction. The torque-push wrapper treats that as success after
#   confirming origin/main already equals HEAD.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# Git hooks inherit repository-local GIT_* variables. The gate runs test suites
# that create and mutate temporary repos; if those variables leak, nested git
# commands can accidentally write this repo's .git/config.
unset $(git rev-parse --local-env-vars)
cd "$REPO_ROOT"
PATH="$REPO_ROOT/bin:$PATH"
export PATH
TORQUE_REMOTE_BIN="$REPO_ROOT/bin/torque-remote"
TORQUE_REMOTE_CMD="$(printf '%q' "$TORQUE_REMOTE_BIN")"
DEFAULT_COORD_LOCK_HELPER="${REPO_ROOT}/scripts/repo-coordination-lock.sh"
COORD_LOCK_HELPER="${TORQUE_COORD_LOCK_HELPER:-$DEFAULT_COORD_LOCK_HELPER}"
if [ ! -f "$COORD_LOCK_HELPER" ] && [ "$COORD_LOCK_HELPER" != "$DEFAULT_COORD_LOCK_HELPER" ] && [ -f "$DEFAULT_COORD_LOCK_HELPER" ]; then
  COORD_LOCK_HELPER="$DEFAULT_COORD_LOCK_HELPER"
fi
if [ ! -f "$COORD_LOCK_HELPER" ]; then
  echo "[pre-push] BLOCKED: coordination lock helper not found at ${COORD_LOCK_HELPER}"
  exit 1
fi
source "$COORD_LOCK_HELPER"

ZERO_SHA="0000000000000000000000000000000000000000"
remote_refs=()
local_head_sha=""
main_local_ref=""
main_remote_sha=""
local_head_short=""
staging_branch=""
staging_ref_created=0
local_gate_worktree_parent=""
local_gate_worktree=""
local_gate_script=""
local_gate_lane_root=""
pre_push_gate_runtime_dir=""
pre_push_gate_phase_file=""
pre_push_gate_heartbeat_pid=""
pre_push_gate_artifact_file=""
pre_push_gate_started_at=""
pre_push_gate_started_at_epoch=""
pre_push_gate_failure_reason=""
pre_push_gate_coalesced=0
pre_push_gate_coalesced_reason=""
pre_push_reaped_leader_info=""
remote_gate_fallback_reason=""
remote_gate_attempt_exit=""
remote_gate_attempt_output_tail=""
PRE_PUSH_COALESCED_EXIT_CODE="${PRE_PUSH_COALESCED_EXIT_CODE:-75}"
case "$PRE_PUSH_COALESCED_EXIT_CODE" in
  ''|*[!0-9]*) PRE_PUSH_COALESCED_EXIT_CODE=75 ;;
esac
if [ "$PRE_PUSH_COALESCED_EXIT_CODE" -eq 0 ]; then
  PRE_PUSH_COALESCED_EXIT_CODE=75
fi

git_cleanup_timeout() {
  local timeout_secs="${PRE_PUSH_STAGING_CLEANUP_TIMEOUT_SECS:-30}"
  case "$timeout_secs" in
    ''|*[!0-9]*) timeout_secs=30 ;;
  esac

  if command -v timeout >/dev/null 2>&1; then
    timeout "$timeout_secs" git "$@"
  else
    git "$@"
  fi
}

# Each line is: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    # Delete-only line — ignore for gating analysis.
    continue
  fi

  already_seen=0
  for existing_ref in "${remote_refs[@]}"; do
    if [ "$existing_ref" = "$remote_ref" ]; then
      already_seen=1
      break
    fi
  done

  if [ "$already_seen" -eq 0 ]; then
    remote_refs+=("$remote_ref")
  fi

  if [ "$remote_ref" = "refs/heads/main" ]; then
    main_local_ref="$local_ref"
    local_head_sha="$local_sha"
    main_remote_sha="$remote_sha"
  fi
done

if [ "${#remote_refs[@]}" -eq 0 ]; then
  echo "[pre-push] Delete-only push, allowing."
  exit 0
fi

main_push=0
for remote_ref in "${remote_refs[@]}"; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    main_push=1
    break
  fi
done

if [ "$main_push" -eq 0 ]; then
  echo "[pre-push] Skipping tests for feature-branch push (${remote_refs[*]}). Main merges will be gated."
  exit 0
fi

if [ -z "$local_head_sha" ]; then
  echo "[pre-push] Main push detected but local sha not captured from stdin — aborting."
  exit 1
fi

local_head_short="$(echo "$local_head_sha" | cut -c1-12)"

if [ -n "$main_remote_sha" ] && [ "$main_remote_sha" = "$local_head_sha" ]; then
  echo "[pre-push] Main is already at $local_head_short; skipping gate."
  exit 0
fi

main_local_ref_current_sha() {
  if [ -z "${main_local_ref:-}" ]; then
    return 1
  fi
  git rev-parse --verify "${main_local_ref}^{commit}" 2>/dev/null
}

pre_push_validate_local_ref_fresh() {
  local current_sha current_short
  if ! current_sha="$(main_local_ref_current_sha)"; then
    echo "[pre-push] BLOCKED: local ref ${main_local_ref:-<unknown>} no longer resolves while waiting for the gate lock."
    echo "[pre-push] Rerun torque-push so the current main tip is gated."
    return 1
  fi
  if [ "$current_sha" = "$local_head_sha" ]; then
    return 0
  fi

  current_short="$(echo "$current_sha" | cut -c1-12)"
  echo "[pre-push] BLOCKED: local ref $main_local_ref moved from $local_head_short to $current_short while waiting for the gate lock."
  echo "[pre-push] Rerun torque-push so the current main tip is gated instead of stale $local_head_short."
  return 1
}

delete_staging_ref() {
  if [ -z "${staging_branch:-}" ] || [ "${staging_ref_created:-0}" -ne 1 ]; then
    return 0
  fi
  # Best-effort cleanup -- never block the hook on a failed cleanup, but keep
  # the disposable ref namespace from accumulating when Git reports success but
  # the remote ref is still visible.
  local delete_rc verify_rc
  if git_cleanup_timeout push --no-verify --quiet origin --delete "$staging_branch" 2>/dev/null; then
    delete_rc=0
  else
    delete_rc=$?
  fi

  if git_cleanup_timeout ls-remote --exit-code --heads origin "$staging_branch" >/dev/null 2>&1; then
    if ! git_cleanup_timeout push --no-verify --quiet origin ":refs/heads/$staging_branch" 2>/dev/null; then
      echo "[pre-push] warn: failed to delete staging ref $staging_branch after verification"
    fi
  else
    verify_rc=$?
    if [ "$verify_rc" -ne 2 ]; then
      if [ "$delete_rc" -ne 0 ]; then
        echo "[pre-push] warn: failed to delete staging ref $staging_branch"
      else
        echo "[pre-push] warn: could not verify staging ref cleanup for $staging_branch"
      fi
    fi
  fi
}

cleanup_abandoned_staging_refs() {
  local sha_prefix="$1"
  local stale_secs="${PRE_PUSH_STAGING_REF_STALE_SECS:-7200}"
  local now refs line remote_sha full_ref branch epoch age should_delete

  case "$stale_secs" in
    ''|*[!0-9]*) stale_secs=7200 ;;
  esac
  now="$(date +%s 2>/dev/null || echo 0)"

  refs="$(git_cleanup_timeout ls-remote --heads origin 'pre-push-gate/*' 2>/dev/null || true)"
  if [ -z "$refs" ]; then
    return 0
  fi

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    remote_sha="${line%%[[:space:]]*}"
    full_ref="${line#*[[:space:]]}"
    branch="${full_ref#refs/heads/}"
    case "$branch" in
      pre-push-gate/*) ;;
      *) continue ;;
    esac

    should_delete=0
    case "$branch" in
      "pre-push-gate/${sha_prefix}-"*) should_delete=1 ;;
    esac

    epoch="${branch#pre-push-gate/????????????-}"
    epoch="${epoch%%-*}"
    case "$epoch" in
      ''|*[!0-9]*) ;;
      *)
        if [ "$now" -gt 0 ]; then
          age=$((now - epoch))
          if [ "$age" -ge "$stale_secs" ]; then
            should_delete=1
          fi
        fi
        ;;
    esac

    if [ "$should_delete" -ne 1 ]; then
      continue
    fi
    if [ "$branch" = "$staging_branch" ]; then
      continue
    fi

    echo "[pre-push] Cleaning abandoned staging ref origin/$branch ($remote_sha)..."
    if ! git_cleanup_timeout push --no-verify --quiet origin --delete "$branch" 2>/dev/null; then
      echo "[pre-push] warn: failed to delete abandoned staging ref origin/$branch"
    fi
  done <<EOF
$refs
EOF
}

cleanup_local_gate_worktree() {
  if [ -z "${local_gate_worktree:-}" ]; then
    return 0
  fi

  cleanup_local_gate_dependency_links

  local remove_output remove_status prune_output prune_status
  if [ -n "${local_gate_script:-}" ]; then
    rm -f "$local_gate_script" 2>/dev/null || true
  fi
  if [ -n "${local_gate_lane_root:-}" ] && [ -d "$local_gate_lane_root" ]; then
    rm -rf "$local_gate_lane_root" 2>/dev/null || true
  fi
  set +e
  remove_output=$(git worktree remove --force "$local_gate_worktree" 2>&1)
  remove_status=$?
  set -e
  if [ "$remove_status" -ne 0 ]; then
    echo "[pre-push] warn: failed to remove local gate worktree $local_gate_worktree (exit $remove_status): ${remove_output:-<no output>}"
  fi
  if [ -e "$local_gate_worktree" ]; then
    echo "[pre-push] warn: local gate worktree still exists after cleanup: $local_gate_worktree"
  elif [ -n "${local_gate_worktree_parent:-}" ] && [ -d "$local_gate_worktree_parent" ]; then
    rmdir "$local_gate_worktree_parent" 2>/dev/null || true
  fi

  set +e
  prune_output=$(git worktree prune 2>&1)
  prune_status=$?
  set -e
  if [ "$prune_status" -ne 0 ]; then
    echo "[pre-push] warn: failed to prune git worktree metadata after local gate cleanup (exit $prune_status): ${prune_output:-<no output>}"
  fi

  local_gate_worktree=""
  local_gate_worktree_parent=""
  local_gate_script=""
  local_gate_lane_root=""
}

cleanup_local_gate_dependency_links() {
  if [ -z "${local_gate_worktree:-}" ]; then
    return 0
  fi

  local dep link link_win
  for dep in dashboard/node_modules server/node_modules; do
    link="$local_gate_worktree/$dep"
    if [ ! -e "$link" ] && [ ! -L "$link" ]; then
      continue
    fi
    if [ -L "$link" ]; then
      # POSIX symlink — safe to remove with rm (Linux or MSYS2 on Windows)
      rm "$link" 2>/dev/null || true
    elif command -v cygpath >/dev/null 2>&1; then
      link_win="$(cygpath -w "$link" 2>/dev/null || printf '%s\n' "$link")"
      # rmdir without /S removes directory symlinks/junctions but refuses real
      # non-empty node_modules directories, so it cannot traverse into the base repo.
      MSYS2_ARG_CONV_EXCL="*" cmd.exe /C rmdir "$link_win" >/dev/null 2>&1 || true
    fi
  done
}

origin_main_matches_local_head() {
  local current_remote_main
  current_remote_main="$(git_cleanup_timeout ls-remote origin refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }' || true)"
  [ -n "$current_remote_main" ] && [ "$current_remote_main" = "$local_head_sha" ]
}

# Defect C — When a same-SHA gate has just finished but the leader's parent
# process died (so it never advanced origin/main), a follower waiter that
# falls out of its while-loop today re-runs the entire gate from scratch.
# Detect a fresh passed artifact for the current HEAD and let the follower
# ride that result: print confirmation and signal the caller to exit 0 so
# git proceeds with the actual push protocol step.
#
# Trust requires ALL of: status=passed, exit_code=0, head_sha matches the
# CURRENT git HEAD (not the captured local_head_sha — guard against HEAD
# drift between gate start and follower wakeup), AND
# created_at_epoch is within PRE_PUSH_PASS_TRUST_WINDOW_SECS (default 1800).
# Set PRE_PUSH_PASS_TRUST_WINDOW_SECS=0 to disable the ride path entirely
# (forces follower-runs-own-gate; useful for tests pinning the negative path).
pre_push_follower_ride_passed_artifact() {
  local trust_window root candidate newest_artifact
  local artifact_status artifact_exit_code artifact_head_sha artifact_created_at_epoch
  local current_head_sha now_epoch age

  trust_window="${PRE_PUSH_PASS_TRUST_WINDOW_SECS:-1800}"
  case "$trust_window" in ''|*[!0-9]*) trust_window=1800 ;; esac
  if [ "$trust_window" -le 0 ]; then
    return 1
  fi

  if [ -z "${local_head_short:-}" ]; then
    return 1
  fi

  root="${PRE_PUSH_GATE_ARTIFACT_ROOT:-$(pre_push_git_common_dir)/torque-pre-push-gate-artifacts}"
  if [ ! -d "$root" ]; then
    return 1
  fi

  current_head_sha="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$current_head_sha" ]; then
    return 1
  fi

  # Find newest artifact matching our short SHA. `-nt` compares mtime, which is
  # what we want here — the gate's cleanup trap rewrites the artifact with the
  # final status, so the most-recently-modified one carries the truth.
  newest_artifact=""
  for candidate in "$root"/"${local_head_short}"-*.txt; do
    [ -f "$candidate" ] || continue
    if [ -z "$newest_artifact" ] || [ "$candidate" -nt "$newest_artifact" ]; then
      newest_artifact="$candidate"
    fi
  done

  if [ -z "$newest_artifact" ]; then
    return 1
  fi

  artifact_status="$(repo_coord_lock_read_field "$newest_artifact" status)"
  artifact_exit_code="$(repo_coord_lock_read_field "$newest_artifact" exit_code)"
  artifact_head_sha="$(repo_coord_lock_read_field "$newest_artifact" head_sha)"
  artifact_created_at_epoch="$(repo_coord_lock_read_field "$newest_artifact" created_at_epoch)"

  [ "$artifact_status" = "passed" ] || return 1
  [ "$artifact_exit_code" = "0" ]   || return 1
  [ "$artifact_head_sha" = "$current_head_sha" ] || return 1

  case "$artifact_created_at_epoch" in
    ''|*[!0-9]*) return 1 ;;
  esac
  now_epoch="$(date +%s)"
  age=$((now_epoch - artifact_created_at_epoch))
  if [ "$age" -gt "$trust_window" ]; then
    return 1
  fi

  echo "[pre-push] Concurrent gate already passed for ${local_head_short} (artifact age ${age}s, trust window ${trust_window}s); proceeding with push."
  return 0
}

pre_push_exit_coalesced() {
  local reason="$1"
  pre_push_gate_coalesced=1
  pre_push_gate_coalesced_reason="$reason"
  echo "[pre-push] COALESCED: $reason"
  echo "[pre-push] origin/main already contains $local_head_short; aborting this duplicate git push before Git attempts a stale ref update."
  echo "[pre-push] torque-push treats this controlled coalesce as success after confirming origin/main."
  exit "$PRE_PUSH_COALESCED_EXIT_CODE"
}

wait_for_matching_pre_push_gate() {
  local lock_dir owner_file expected_purpose owner_purpose wait_secs poll_secs notice_secs deadline now next_notice

  lock_dir="$(repo_coord_lock_path main)"
  if [ ! -d "$lock_dir" ]; then
    return 1
  fi

  owner_file="$lock_dir/owner.env"
  expected_purpose="pre-push main gate: $local_head_short"
  owner_purpose="$(repo_coord_lock_read_field "$owner_file" purpose)"
  if [ "$owner_purpose" != "$expected_purpose" ]; then
    return 1
  fi

  wait_secs="${PRE_PUSH_MATCHING_GATE_WAIT_SECS:-${TORQUE_COORD_LOCK_WAIT_SECS:-7200}}"
  poll_secs="${TORQUE_COORD_LOCK_POLL_SECS:-5}"
  notice_secs="${TORQUE_COORD_LOCK_NOTICE_SECS:-30}"
  case "$wait_secs" in ''|*[!0-9]*) wait_secs=7200 ;; esac
  case "$poll_secs" in ''|*[!0-9]*) poll_secs=5 ;; esac
  case "$notice_secs" in ''|*[!0-9]*) notice_secs=30 ;; esac

  echo "[pre-push] Another pre-push gate for $local_head_short is already running; waiting for its result."
  deadline=$(( $(date +%s) + wait_secs ))
  next_notice=0

  while [ -d "$lock_dir" ]; do
    # Defect B — snapshot the owner BEFORE invoking the reap helpers so we can
    # report (and persist in the follower's eventual artifact) which leader
    # process actually died or went stale. The reap helpers remove owner.env
    # and the lock dir, so a post-reap describe would return "unknown".
    local pre_reap_snapshot=""
    if [ -f "$lock_dir/owner.env" ]; then
      pre_reap_snapshot="$(repo_coord_lock_describe "$lock_dir" 2>/dev/null || true)"
    fi
    if repo_coord_lock_reap_if_dead_owner "$lock_dir"; then
      pre_push_reaped_leader_info="dead_owner: ${pre_reap_snapshot:-unknown}"
      echo "[pre-push] Previous matching gate owner is gone (${pre_reap_snapshot:-unknown}); this push will run the gate."
      return 1
    fi
    if repo_coord_lock_reap_if_stale "$lock_dir"; then
      pre_push_reaped_leader_info="stale_lease: ${pre_reap_snapshot:-unknown}"
      echo "[pre-push] Previous matching gate lease was stale (${pre_reap_snapshot:-unknown}); this push will run the gate."
      return 1
    fi

    owner_file="$lock_dir/owner.env"
    owner_purpose="$(repo_coord_lock_read_field "$owner_file" purpose)"
    if [ "$owner_purpose" != "$expected_purpose" ]; then
      echo "[pre-push] Main gate lease changed owner; this push will join the normal lock queue."
      return 1
    fi

    if origin_main_matches_local_head; then
      pre_push_exit_coalesced "Concurrent pre-push gate already updated origin/main to $local_head_short."
    fi

    now="$(date +%s)"
    if [ "$now" -ge "$deadline" ]; then
      echo "[pre-push] Timed out waiting for matching pre-push gate; this push will join the normal lock queue."
      return 1
    fi

    if [ "$now" -ge "$next_notice" ]; then
      echo "[pre-push] Waiting for active gate owner: $(repo_coord_lock_describe "$lock_dir")"
      next_notice=$((now + notice_secs))
    fi
    sleep "$poll_secs"
  done

  if origin_main_matches_local_head; then
    pre_push_exit_coalesced "Concurrent pre-push gate completed and origin/main is at $local_head_short."
  fi

  # Defect C — leader's gate passed but origin/main wasn't advanced (typically
  # the leader's parent process died before the gate finished). Let this
  # follower ride the leader's pass and proceed to the actual push. We exit 0
  # directly because the EXIT trap isn't installed yet (trap is set after the
  # wait function returns) — falling through to repo_coord_lock_acquire +
  # gate-run is exactly what we want to avoid.
  if pre_push_follower_ride_passed_artifact; then
    exit 0
  fi

  echo "[pre-push] Previous matching gate finished without updating origin/main; this push will run the gate."
  return 1
}

coord_lock_env_reset_cmd() {
  printf '%s' 'env -u TORQUE_COORD_LOCK_ROOT -u TORQUE_COORD_LOCK_DIR -u TORQUE_COORD_LOCK_TOKEN -u TORQUE_COORD_LOCK_NAME -u TORQUE_COORD_LOCK_OWNER_BASHPID -u REPO_COORD_LOCK_DIR -u REPO_COORD_LOCK_TOKEN -u REPO_COORD_LOCK_NAME -u REPO_COORD_LOCK_REUSED -u REPO_COORD_LOCK_OWNER_BASHPID -u REPO_COORD_LOCK_FORCE_RELEASE'
}

pre_push_gate_metadata_value() {
  printf '%s' "${1:-}" | tr '\r\n' '  '
}

pre_push_git_common_dir() {
  local common_dir
  common_dir="$(git -C "$REPO_ROOT" rev-parse --git-common-dir)"
  case "$common_dir" in
    /*|[A-Za-z]:/*|[A-Za-z]:\\*) ;;
    *) common_dir="$REPO_ROOT/$common_dir" ;;
  esac
  printf '%s\n' "$common_dir"
}

pre_push_file_mtime_epoch() {
  local file="$1"
  stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null || echo 0
}

pre_push_set_gate_phase() {
  local phase="${1:-unknown}"
  local detail="${2:-}"
  local output_file="${3:-}"
  local tmp

  if [ -z "${pre_push_gate_phase_file:-}" ]; then
    return 0
  fi

  tmp="${pre_push_gate_phase_file}.$$"
  {
    printf 'phase=%s\n' "$(pre_push_gate_metadata_value "$phase")"
    printf 'detail=%s\n' "$(pre_push_gate_metadata_value "$detail")"
    printf 'output_file=%s\n' "$(pre_push_gate_metadata_value "$output_file")"
  } > "$tmp"
  mv -f "$tmp" "$pre_push_gate_phase_file" 2>/dev/null || true
  pre_push_write_gate_heartbeat_once >/dev/null 2>&1 || true
  pre_push_write_gate_artifact "running" "" >/dev/null 2>&1 || true
}

pre_push_write_gate_heartbeat_once() {
  local lock_dir="${REPO_COORD_LOCK_DIR:-${TORQUE_COORD_LOCK_DIR:-}}"
  local token="${REPO_COORD_LOCK_TOKEN:-${TORQUE_COORD_LOCK_TOKEN:-}}"
  local phase_file="${pre_push_gate_phase_file:-}"
  local phase detail output_file now_epoch now_iso output_bytes output_age_seconds output_mtime tmp

  if [ -z "$lock_dir" ] || [ -z "$token" ] || [ -z "$phase_file" ]; then
    return 1
  fi
  if [ ! -d "$lock_dir" ] || [ "$(cat "$lock_dir/token" 2>/dev/null || true)" != "$token" ]; then
    return 1
  fi

  phase="$(repo_coord_lock_read_field "$phase_file" phase)"
  detail="$(repo_coord_lock_read_field "$phase_file" detail)"
  output_file="$(repo_coord_lock_read_field "$phase_file" output_file)"
  now_epoch="$(date +%s)"
  now_iso="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)"
  output_bytes=0
  output_age_seconds=""

  if [ -n "$output_file" ] && [ -f "$output_file" ]; then
    output_bytes="$(wc -c < "$output_file" 2>/dev/null | tr -d '[:space:]')"
    output_mtime="$(pre_push_file_mtime_epoch "$output_file")"
    case "$output_mtime" in
      ''|*[!0-9]*) output_age_seconds="" ;;
      *) output_age_seconds="$((now_epoch - output_mtime))" ;;
    esac
  fi

  tmp="$lock_dir/heartbeat.env.$$"
  {
    printf 'updated_at=%s\n' "$now_iso"
    printf 'updated_at_epoch=%s\n' "$now_epoch"
    printf 'phase=%s\n' "${phase:-unknown}"
    printf 'detail=%s\n' "${detail:-}"
    printf 'output_file=%s\n' "${output_file:-}"
    printf 'output_bytes=%s\n' "${output_bytes:-0}"
    printf 'output_age_seconds=%s\n' "$output_age_seconds"
    printf 'artifact_file=%s\n' "${pre_push_gate_artifact_file:-}"
  } > "$tmp"
  mv -f "$tmp" "$lock_dir/heartbeat.env" 2>/dev/null || true
}

pre_push_artifact_output_tail() {
  local output_file="${1:-}"
  if [ -n "${combined_output:-}" ]; then
    printf '%s\n' "$combined_output" | tail -120
    return 0
  fi
  if [ -n "${RETRIED_OUTPUT:-}" ]; then
    printf '%s\n' "$RETRIED_OUTPUT" | tail -120
    return 0
  fi
  if [ -n "$output_file" ] && [ -f "$output_file" ]; then
    tail -120 "$output_file" 2>/dev/null || true
  fi
}

pre_push_prune_gate_artifacts() {
  local root="$1"
  local max="${PRE_PUSH_GATE_ARTIFACT_MAX_FILES:-50}"
  local stale

  case "$max" in
    ''|*[!0-9]*) max=50 ;;
  esac
  if [ "$max" -le 0 ]; then
    return 0
  fi

  find "$root" -maxdepth 1 -type f -name '*.txt' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn \
    | tail -n +"$((max + 1))" \
    | sed 's/^[^ ]* //' \
    | while IFS= read -r stale; do
        [ -n "$stale" ] && rm -f "$stale" >/dev/null 2>&1 || true
      done
}

pre_push_start_gate_artifact() {
  local root stamp
  if [ -n "${pre_push_gate_artifact_file:-}" ]; then
    return 0
  fi

  root="${PRE_PUSH_GATE_ARTIFACT_ROOT:-$(pre_push_git_common_dir)/torque-pre-push-gate-artifacts}"
  if ! mkdir -p "$root"; then
    echo "[pre-push] warn: could not create gate artifact directory $root; continuing without a gate artifact."
    pre_push_gate_artifact_file=""
    return 0
  fi
  pre_push_prune_gate_artifacts "$root" || true
  stamp="$(date -u +"%Y%m%dT%H%M%SZ" 2>/dev/null || date +%s)"
  pre_push_gate_started_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)"
  pre_push_gate_started_at_epoch="$(date +%s)"
  pre_push_gate_artifact_file="$root/${local_head_short:-unknown}-$stamp-$$.txt"
  pre_push_write_gate_artifact "running" "" || true
}

pre_push_write_gate_artifact() {
  local status="${1:-running}"
  local exit_code="${2:-}"
  local now_iso now_epoch phase detail output_file output_bytes output_age_seconds output_mtime tmp

  if [ -z "${pre_push_gate_artifact_file:-}" ]; then
    return 0
  fi

  now_iso="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)"
  now_epoch="$(date +%s)"
  phase=""
  detail=""
  output_file=""
  if [ -n "${pre_push_gate_phase_file:-}" ] && [ -f "$pre_push_gate_phase_file" ]; then
    phase="$(repo_coord_lock_read_field "$pre_push_gate_phase_file" phase)"
    detail="$(repo_coord_lock_read_field "$pre_push_gate_phase_file" detail)"
    output_file="$(repo_coord_lock_read_field "$pre_push_gate_phase_file" output_file)"
  fi

  output_bytes=0
  output_age_seconds=""
  if [ -n "$output_file" ] && [ -f "$output_file" ]; then
    output_bytes="$(wc -c < "$output_file" 2>/dev/null | tr -d '[:space:]')"
    output_mtime="$(pre_push_file_mtime_epoch "$output_file")"
    case "$output_mtime" in
      ''|*[!0-9]*) output_age_seconds="" ;;
      *) output_age_seconds="$((now_epoch - output_mtime))" ;;
    esac
  fi

  tmp="${pre_push_gate_artifact_file}.$$"
  {
    printf 'pre_push_gate_artifact_version=1\n'
    printf 'status=%s\n' "$(pre_push_gate_metadata_value "$status")"
    printf 'exit_code=%s\n' "$(pre_push_gate_metadata_value "$exit_code")"
    printf 'created_at=%s\n' "$(pre_push_gate_metadata_value "$pre_push_gate_started_at")"
    printf 'created_at_epoch=%s\n' "$(pre_push_gate_metadata_value "$pre_push_gate_started_at_epoch")"
    printf 'updated_at=%s\n' "$now_iso"
    printf 'updated_at_epoch=%s\n' "$now_epoch"
    printf 'head_sha=%s\n' "$(pre_push_gate_metadata_value "${local_head_sha:-}")"
    printf 'head_short=%s\n' "$(pre_push_gate_metadata_value "${local_head_short:-}")"
    printf 'hook_command=%s\n' "$(pre_push_gate_metadata_value "$0")"
    printf 'torque_remote_bin=%s\n' "$(pre_push_gate_metadata_value "$TORQUE_REMOTE_BIN")"
    printf 'remote_main_sha=%s\n' "$(pre_push_gate_metadata_value "${remote_main_sha:-}")"
    printf 'main_remote_sha=%s\n' "$(pre_push_gate_metadata_value "${main_remote_sha:-}")"
    printf 'gate_mode=%s\n' "$(pre_push_gate_metadata_value "${GATE_MODE:-}")"
    printf 'gate_plan_hash=%s\n' "$(pre_push_gate_metadata_value "${GATE_PLAN_HASH:-}")"
    printf 'gate_coord_suite=%s\n' "$(pre_push_gate_metadata_value "${GATE_COORD_SUITE:-}")"
    printf 'gate_plan_summary=%s\n' "$(pre_push_gate_metadata_value "${GATE_PLAN_SUMMARY:-}")"
    printf 'execution_mode=%s\n' "$(pre_push_gate_metadata_value "${pre_push_gate_execution_mode:-}")"
    printf 'staging_branch=%s\n' "$(pre_push_gate_metadata_value "${staging_branch:-}")"
    printf 'staging_ref_created=%s\n' "$(pre_push_gate_metadata_value "${staging_ref_created:-}")"
    printf 'remote_probe_reason=%s\n' "$(pre_push_gate_metadata_value "${remote_probe_reason:-}")"
    printf 'remote_gate_fallback_reason=%s\n' "$(pre_push_gate_metadata_value "${remote_gate_fallback_reason:-}")"
    printf 'remote_gate_attempt_exit=%s\n' "$(pre_push_gate_metadata_value "${remote_gate_attempt_exit:-}")"
    printf 'remote_gate_attempt_output_tail_present=%s\n' "$([ -n "${remote_gate_attempt_output_tail:-}" ] && echo 1 || echo 0)"
    printf 'phase=%s\n' "$(pre_push_gate_metadata_value "$phase")"
    printf 'detail=%s\n' "$(pre_push_gate_metadata_value "$detail")"
    printf 'output_file=%s\n' "$(pre_push_gate_metadata_value "$output_file")"
    printf 'output_bytes=%s\n' "$(pre_push_gate_metadata_value "$output_bytes")"
    printf 'output_age_seconds=%s\n' "$(pre_push_gate_metadata_value "$output_age_seconds")"
    printf 'gate_end_marker=%s\n' "$(pre_push_gate_metadata_value "${gate_end_marker:-}")"
    printf 'combined_exit=%s\n' "$(pre_push_gate_metadata_value "${combined_exit:-}")"
    printf 'dash_exit=%s\n' "$(pre_push_gate_metadata_value "${dash_exit:-}")"
    printf 'server_exit=%s\n' "$(pre_push_gate_metadata_value "${server_exit:-}")"
    printf 'perf_exit=%s\n' "$(pre_push_gate_metadata_value "${perf_exit:-}")"
    printf 'failure_reason=%s\n' "$(pre_push_gate_metadata_value "$pre_push_gate_failure_reason")"
    printf 'coalesced_reason=%s\n' "$(pre_push_gate_metadata_value "$pre_push_gate_coalesced_reason")"
    printf 'reaped_leader_info=%s\n' "$(pre_push_gate_metadata_value "$pre_push_reaped_leader_info")"
    printf '\n[output-tail]\n'
    pre_push_artifact_output_tail "$output_file"
    if [ -n "${remote_gate_attempt_output_tail:-}" ]; then
      printf '\n[remote-output-tail]\n'
      printf '%s\n' "$remote_gate_attempt_output_tail"
    fi
  } > "$tmp"
  mv -f "$tmp" "$pre_push_gate_artifact_file" 2>/dev/null || true
}

pre_push_start_gate_heartbeat() {
  local interval artifact_refresh_secs artifact_refresh_ratio
  if [ -n "${pre_push_gate_heartbeat_pid:-}" ]; then
    return 0
  fi

  pre_push_gate_runtime_dir="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-gate-runtime.XXXXXX")"
  pre_push_gate_phase_file="$pre_push_gate_runtime_dir/phase.env"
  pre_push_set_gate_phase "starting" "pre-push gate acquired main lease"
  interval="${PRE_PUSH_GATE_HEARTBEAT_SECS:-10}"
  case "$interval" in ''|*[!0-9]*) interval=10 ;; esac

  # Defect A — artifact refresh in the heartbeat loop. The artifact is the file
  # a follower consults to decide whether a same-SHA gate has finished; without
  # this it only updates on phase transitions, so a long Local-gate phase
  # leaves the artifact's `updated_at` stale for 10+ min while heartbeats tick
  # every $interval seconds. Refresh ratio rounds down so artifact writes stay
  # bounded — default 30s artifact cadence vs 10s heartbeat = ratio 3.
  artifact_refresh_secs="${PRE_PUSH_GATE_ARTIFACT_REFRESH_SECS:-30}"
  case "$artifact_refresh_secs" in ''|*[!0-9]*) artifact_refresh_secs=30 ;; esac
  if [ "$artifact_refresh_secs" -le "$interval" ]; then
    artifact_refresh_ratio=1
  else
    artifact_refresh_ratio=$(( artifact_refresh_secs / interval ))
    [ "$artifact_refresh_ratio" -lt 1 ] && artifact_refresh_ratio=1
  fi

  (
    tick=0
    while pre_push_write_gate_heartbeat_once; do
      tick=$((tick + 1))
      if [ "$((tick % artifact_refresh_ratio))" -eq 0 ]; then
        pre_push_write_gate_artifact "running" "" >/dev/null 2>&1 || true
      fi
      sleep "$interval"
    done
  ) &
  pre_push_gate_heartbeat_pid=$!
}

pre_push_stop_gate_heartbeat() {
  if [ -n "${pre_push_gate_heartbeat_pid:-}" ]; then
    kill "$pre_push_gate_heartbeat_pid" 2>/dev/null || true
    wait "$pre_push_gate_heartbeat_pid" 2>/dev/null || true
    pre_push_gate_heartbeat_pid=""
  fi
  if [ -n "${pre_push_gate_runtime_dir:-}" ]; then
    rm -rf "$pre_push_gate_runtime_dir" >/dev/null 2>&1 || true
    pre_push_gate_runtime_dir=""
    pre_push_gate_phase_file=""
  fi
}

pre_push_cleanup() {
  local rc=$?
  local status
  trap - EXIT
  pre_push_set_gate_phase "cleanup" "exit=$rc"
  if [ "${pre_push_gate_coalesced:-0}" = "1" ]; then
    status="coalesced"
  elif [ "$rc" -eq 0 ]; then
    status="passed"
  else
    status="failed"
  fi
  pre_push_write_gate_artifact "$status" "$rc" || true
  cleanup_local_gate_worktree || true
  delete_staging_ref || true
  REPO_COORD_LOCK_FORCE_RELEASE=1 repo_coord_lock_release || true
  pre_push_stop_gate_heartbeat || true
  exit "$rc"
}

wait_for_matching_pre_push_gate || true

repo_coord_lock_acquire "main" "pre-push main gate: $local_head_short"
if ! pre_push_validate_local_ref_fresh; then
  REPO_COORD_LOCK_FORCE_RELEASE=1 repo_coord_lock_release || true
  exit 1
fi
pre_push_start_gate_artifact
pre_push_start_gate_heartbeat
trap pre_push_cleanup EXIT

if origin_main_matches_local_head; then
  pre_push_exit_coalesced "Main reached $local_head_short while waiting for the gate lock."
fi

pre_push_set_gate_phase "planning" "cleaning staging refs and building gate plan"
cleanup_abandoned_staging_refs "$local_head_short"
# vitest writes its summary with ANSI color codes even under `--reporter=dot`,
# which causes `^[[:space:]]*Test Files` anchors to fail (the line begins with
# an ESC byte, not whitespace). Strip ANSI before matching so the grep patterns
# see the plain text they were written against. Observed 2026-04-21 when a
# "Test Files 5 failed | 18989 Tests passed" run failed to trigger the
# file-load-flake retry — the retry helper ran but `is_file_load_only_flake`
# returned false on the ANSI-wrapped output, so neither retry nor failure
# classification worked.
strip_ansi() {
  # Matches CSI sequences `ESC [ … m` — enough for vitest's color output.
  # Printed as $'\x1b' (bash ANSI-C quoting) so it works on git-bash + mac sed.
  sed $'s/\x1b\\[[0-9;]*m//g'
}

# Strip the `[dash] `/`[serv] ` line prefix added when both phases run in
# parallel inside a single SSH session. Lines without the prefix pass
# through untouched, so this is safe to apply to any output.
strip_phase_prefix() {
  sed -E 's/^\[(dash|serv)\] //'
}

gate_marker_value() {
  local marker="$1"
  local field="$2"
  local token value=""

  for token in $marker; do
    case "$token" in
      "$field="*) value="${token#*=}" ;;
    esac
  done

  case "$value" in
    ""|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$value"
}

parse_gate_end_exits() {
  local marker="$1"
  local dash_exit server_exit perf_exit

  case "$marker" in
    "[gate-end] dash_exit="*" serv_exit="*" perf_exit="*) ;;
    *) return 1 ;;
  esac

  dash_exit=$(gate_marker_value "$marker" "dash_exit") || return 1
  server_exit=$(gate_marker_value "$marker" "serv_exit") || return 1
  perf_exit=$(gate_marker_value "$marker" "perf_exit") || return 1
  printf '%s %s %s\n' "$dash_exit" "$server_exit" "$perf_exit"
}

extract_gate_end_marker() {
  local output="$1"
  local line marker=""

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      "[gate-end] dash_exit="*) marker="$line" ;;
    esac
  done <<< "$output"

  if parse_gate_end_exits "$marker" >/dev/null; then
    printf '%s\n' "$marker"
    return 0
  fi
  return 1
}

# vitest prints two summary lines:
#   Test Files  1 failed | 890 passed | 4 skipped (895)
#   Tests       18564 passed | 27 skipped | 10 todo (18601)
# A file-load failure (import error, syntax) increments "Test Files failed"
# without any individual test recording as failed — so the check must match
# either line. The previous 'Tests .* failed' pattern missed this case and
# silently let pushes through with a red test file.
tests_have_failures() {
  local output="$1"
  echo "$output" | strip_ansi | strip_phase_prefix | grep -qE '^[[:space:]]*(Test Files|Tests)[[:space:]].*failed'
}

print_gate_failure_summary() {
  local label="$1"
  local output="$2"
  local exit_code="$3"
  local marker="${4:-}"
  local plain summary

  plain=$(echo "$output" | strip_ansi | strip_phase_prefix)
  echo "[pre-push] ${label} failure summary (exit ${exit_code})"
  if [ -n "$marker" ]; then
    echo "[pre-push] final gate marker: $marker"
  fi

  summary=$(echo "$plain" | grep -E '^[[:space:]]*(FAIL|Test Files|Tests|Duration)[[:space:]]|Failed Tests|AssertionError|Error:' | tail -40 || true)
  if [ -n "$summary" ]; then
    echo "[pre-push] ${label} vitest summary:"
    printf '%s\n' "$summary"
  fi

  echo "[pre-push] ${label} output tail:"
  printf '%s\n' "$plain" | tail -80
}

# Distinguishes real test failures (tests that ran and asserted wrong) from
# transient file-load failures (vitest's /@id/ internal module resolver
# flaking under parallel load; "N Test Files failed | 0 Tests failed").
# Real test failures should fail the gate immediately. File-load flakes
# deserve one retry before blocking.
is_file_load_only_flake() {
  local output="$1"
  local plain
  plain=$(echo "$output" | strip_ansi | strip_phase_prefix)
  # "Tests  N failed" means real assertion failures — not a flake
  if echo "$plain" | grep -qE '^[[:space:]]*Tests[[:space:]]+[0-9]+ failed'; then
    return 1
  fi
  # "Test Files N failed" with no test-level failures — likely file-load flake
  if echo "$plain" | grep -qE '^[[:space:]]*Test Files[[:space:]].*failed'; then
    return 0
  fi
  return 1
}

# Detects a native crash inside a vitest worker — broader than "segfault"
# despite the legacy name. Root cause cluster: better-sqlite3 12.x + Node 24
# + worker_threads (https://github.com/WiseLibs/better-sqlite3/issues/1376),
# libuv handle-state asserts in src\win\handle.c on async I/O races, and the
# occasional V8 abort. All three kill the vitest process before it prints a
# "Test Files" summary, so is_file_load_only_flake() can't see them. Match
# the wire-level signatures for each. Pair with the same real-failure guard
# so a crash that follows a real assertion failure doesn't get retried.
#
# Patterns (any one is sufficient):
#   - "Segmentation fault" — npx's wrapper prints this on signal 11
#   - "SIGSEGV" / "exit code 139" — alternate wordings for signal 11
#   - "Assertion failed:" + ".c, line" — libuv/V8 native asserts (e.g.
#     "Assertion failed: 0, file src\\win\\handle.c, line 71")
#   - "FATAL ERROR" — V8 fatal abort (OOM, ineffective mark-compacts, etc.)
#   - "Aborted" / "abort()" — explicit abort calls in native code
#   - "exit code 134" / "exit code 127" — common abnormal exits when the
#     shell maps a native abort to a non-zero rc on Windows. We bound this
#     to lines that ALSO contain a crash phrase, so we don't retry a
#     legitimate "command not found" 127.
is_segfault_flake() {
  local output="$1"
  local plain
  plain=$(echo "$output" | strip_ansi | strip_phase_prefix)
  if echo "$plain" | grep -qE '^[[:space:]]*Tests[[:space:]]+[0-9]+ failed'; then
    return 1
  fi
  if echo "$plain" | grep -qE 'Segmentation fault|SIGSEGV|exit code 139|exit code 134|Aborted|abort\(\)|FATAL ERROR'; then
    return 0
  fi
  # libuv-style native assertion. Restrict to .c source files so we don't
  # match incidental "Assertion failed" strings inside JS test output.
  if echo "$plain" | grep -qE 'Assertion failed:.*\.c, line [0-9]+'; then
    return 0
  fi
  return 1
}

# Detects torque-remote's explicit guard for a shared remote checkout being
# swapped between sync and command execution. This is transient when another
# already-running client does not honor the remote worktree lock; retry once
# after a short backoff instead of failing the whole push immediately.
is_remote_worktree_contamination() {
  local output="$1"
  local plain
  plain=$(echo "$output" | strip_ansi | strip_phase_prefix)
  echo "$plain" | grep -qE '\[torque-remote-sync\] worktree HEAD .*does not match .*concurrent torque-remote session likely clobbered the checkout'
}

# Returns 0 (true) if the gate-end marker reports any nonzero phase exit.
# Used to gate retry decisions independently of $RETRIED_EXIT, which is
# unreliable: under Git Bash on Windows the wait/eval/`&` pipeline
# occasionally surfaces 0 even when the inner SSH command exited nonzero
# (observed 2026-04-27: dash_exit=1 serv_exit=127 in the marker but
# RETRIED_EXIT==0, so the file-load-flake retry never fired). The marker
# is printed verbatim by the parallel-gate heredoc and is the ground truth.
gate_marker_has_failure() {
  local output="$1"
  local marker gate_exits dash_exit server_exit perf_exit
  marker=$(extract_gate_end_marker "$output") || return 1
  gate_exits=$(parse_gate_end_exits "$marker") || return 1
  set -- $gate_exits
  dash_exit="$1"
  server_exit="$2"
  perf_exit="$3"
  [ "$dash_exit" -ne 0 ] || [ "$server_exit" -ne 0 ] || [ "$perf_exit" -ne 0 ]
}

# Per-phase timeout caps pathological SSH stalls. Set generously over the
# observed worst case so a slow but legitimate run is not killed mid-suite.
# History:
#   2026-04-25 (0fb2524ed): default 600s — measured dashboard 52s, server 141s
#   2026-04-29: server suite grew past 600s after the factory-coordination
#     batch landed (~1075 server test files vs. ~600 in late April). Pushes
#     started failing with `[gate-end] dash_exit=0 serv_exit=1`, no vitest
#     summary, output cut mid-test — the fingerprint of `timeout` killing
#     vitest before the `echo $?` line could write to SERV_EXIT_FILE, so
#     the missing-file fallback wrote "1". Bumped default to 1800s (30 min).
#     Override via PRE_PUSH_PHASE_TIMEOUT_SECS when needed.
PHASE_TIMEOUT_SECS="${PRE_PUSH_PHASE_TIMEOUT_SECS:-1800}"

# Run a test command with one auto-retry if the only failure shape is
# file-load (see is_file_load_only_flake). Exports RETRIED_OUTPUT and
# RETRIED_EXIT so the caller can evaluate the final result.
#
# Streams output to the user's terminal in real time AND captures it to a
# tempfile for the retry/failure analysis below. We deliberately do NOT
# pipe the command into `tee`: on Git Bash + Windows, ssh leaks its stdio
# handles to a child process that doesn't release them, so `tee` never
# sees EOF on its stdin pipe and hangs indefinitely after the gate has
# already finished printing `[gate-end] dash_exit=N serv_exit=M`. The leak
# is invisible because `eval`/`ssh`/`torque-remote` have all exited — the
# only proof is `ps -ef` showing a stranded `tee`.
#
# Workaround: redirect the command to the tempfile in the background, and
# have a sibling `tail -f --pid=<eval-pid>` stream the file to stdout.
# The tempfile is the canonical capture; PIPESTATUS does not enter the picture.
# Stop the streamer explicitly after the writer exits because Git Bash on
# Windows can leave `tail --pid` alive after the watched process is gone.
#
# Background+wait also gives the inner command its own process group, so
# the tempfile redirect terminates cleanly the moment `wait $CMD_PID`
# returns — no fd inheritance up the chain.
run_with_flake_retry_inner() {
  local cmd="$1"
  local tmp="$2"
  local cmd_pid tail_pid
  : > "$tmp"
  eval "$cmd" > "$tmp" 2>&1 &
  cmd_pid=$!
  tail -f --pid="$cmd_pid" "$tmp" &
  tail_pid=$!
  wait "$cmd_pid"
  RETRIED_EXIT=$?
  sleep 0.2
  kill "$tail_pid" 2>/dev/null || true
  wait "$tail_pid" 2>/dev/null || true

  # Wait for the tempfile to stop growing. On Git Bash + Windows, `wait`
  # can return as soon as the eval subshell exits, but the OS may still be
  # flushing the final stdio writes from the redirect. Without this quiesce
  # loop the caller can read an incomplete `$tmp` that's missing the last
  # few lines — including `[gate-end] dash_exit=N serv_exit=M` printed by
  # the parallel-gate heredoc. When that marker is missing the failure
  # attribution falls back to combined_exit and reports the wrong phase.
  # Observed today: dashboard stream kept arriving for ~3-4s after the
  # gate-end echo, pushing the marker into the long tail. A single quiet
  # 200ms sample is not enough to prove quiescence, so require repeated
  # stable samples while still capping the wait at 30 x 200ms = 6 s.
  # If the marker is found before then, exit early to keep the hook snappy.
  local size_a size_b iter stable_count
  size_a=$(wc -c < "$tmp" 2>/dev/null || echo 0)
  stable_count=0
  for iter in $(seq 1 30); do
    sleep 0.2
    # Fast-exit once the parallel-gate marker is present — it's the only
    # parsing input we strictly need from the tail.
    # Require digits after `dash_exit=` so this regex doesn't match the
    # `[torque-remote] Running on ...` source-string log line, which echoes
    # the literal heredoc body containing `dash_exit=$DASH_EXIT` (no digits).
    # That false match was triggering fast-exit BEFORE the actual gate-end
    # marker arrived, then the parser fell back to combined_exit and reported
    # the wrong phase as failed.
    grep -qE '\[gate-end\] dash_exit=[0-9]' "$tmp" 2>/dev/null && break
    size_b=$(wc -c < "$tmp" 2>/dev/null || echo 0)
    if [ "$size_a" = "$size_b" ]; then
      stable_count=$((stable_count + 1))
      [ "$stable_count" -ge 5 ] && break
    else
      stable_count=0
      size_a="$size_b"
    fi
  done
}

run_with_flake_retry_inner_streaming() {
  local cmd="$1"
  local tmp="$2"
  local script
  : > "$tmp"
  script=$(mktemp -t prepush-local-cmd.XXXXXX.sh)
  printf '%s\n' "$cmd" > "$script"
  node "$REPO_ROOT/scripts/pre-push-tee-runner.js" --output "$tmp" -- bash "$script"
  RETRIED_EXIT=$?
  rm -f "$script"
}

run_with_flake_retry_with_runner() {
  local label="$1"
  local cmd="$2"
  local runner="$3"
  local tmp
  tmp=$(mktemp -t prepush.XXXXXX)
  pre_push_set_gate_phase "$label" "running" "$tmp"

  set +e
  "$runner" "$cmd" "$tmp"
  set -e
  RETRIED_OUTPUT=$(<"$tmp")

  # Gate retry on EITHER RETRIED_EXIT being nonzero OR the gate-end marker
  # reporting any nonzero phase exit. RETRIED_EXIT alone is unreliable on
  # Git Bash + Windows when the eval'd ssh command crashes mid-stream (the
  # 2026-04-27 measurement saw `dash_exit=1 serv_exit=127` in the marker but
  # RETRIED_EXIT==0, so neither flake retry fired). gate_marker_has_failure
  # is the ground truth; combined with the existing exit-code check it
  # belt-and-suspenders the retry trigger.
  if { [ "$RETRIED_EXIT" -ne 0 ] || gate_marker_has_failure "$RETRIED_OUTPUT"; } \
       && is_remote_worktree_contamination "$RETRIED_OUTPUT"; then
    echo "[pre-push] $label: remote worktree contamination detected -- blocking this push; wait for the conflicting sync to finish and rerun git push."
    RETRIED_EXIT=98
  elif { [ "$RETRIED_EXIT" -ne 0 ] || gate_marker_has_failure "$RETRIED_OUTPUT"; } \
       && is_file_load_only_flake "$RETRIED_OUTPUT"; then
    echo "[pre-push] $label: file-load flake detected (0 test failures, N file-load failures) — retrying once..."
    pre_push_set_gate_phase "$label" "retrying file-load flake" "$tmp"
    set +e
    "$runner" "$cmd" "$tmp"
    set -e
    RETRIED_OUTPUT=$(<"$tmp")
  elif { [ "$RETRIED_EXIT" -ne 0 ] || gate_marker_has_failure "$RETRIED_OUTPUT"; } \
         && is_segfault_flake "$RETRIED_OUTPUT"; then
    echo "[pre-push] $label: native crash detected (segfault / libuv assert / V8 abort) — retrying once..."
    pre_push_set_gate_phase "$label" "retrying native crash flake" "$tmp"
    set +e
    "$runner" "$cmd" "$tmp"
    set -e
    RETRIED_OUTPUT=$(<"$tmp")
  fi

  pre_push_set_gate_phase "$label" "complete exit=$RETRIED_EXIT" "$tmp"
  rm -f "$tmp"
}

run_with_flake_retry() {
  run_with_flake_retry_with_runner "$1" "$2" run_with_flake_retry_inner
}

run_with_flake_retry_streaming() {
  run_with_flake_retry_with_runner "$1" "$2" run_with_flake_retry_inner_streaming
}

prepare_local_gate_worktree() {
  if [ -n "${local_gate_worktree:-}" ]; then
    return 0
  fi

  local_gate_worktree_parent=$(mktemp -d "$(pre_push_local_gate_tmp_root)/pre-push-local-gate.XXXXXX")
  local_gate_worktree="$local_gate_worktree_parent/worktree"
  local_gate_script="$local_gate_worktree_parent/gate-command.sh"
  local_gate_lane_root="$local_gate_worktree_parent/lane"
  echo "[pre-push] Preparing local gate worktree at $local_gate_worktree for $local_head_sha..."
  git worktree add --force --detach "$local_gate_worktree" "$local_head_sha" >/dev/null
}

pre_push_local_gate_tmp_root() {
  local candidate
  if [ -n "${TORQUE_PRE_PUSH_LOCAL_TMPDIR:-}" ]; then
    mkdir -p "$TORQUE_PRE_PUSH_LOCAL_TMPDIR"
    printf '%s\n' "$TORQUE_PRE_PUSH_LOCAL_TMPDIR"
    return 0
  fi

  if command -v cygpath >/dev/null 2>&1 || [ -n "${MSYSTEM:-}" ] || [ -n "${WINDIR:-}" ]; then
    if command -v cygpath >/dev/null 2>&1; then
      candidate=$(cygpath -u "${SystemDrive:-C:}\\tmp\\torque-pre-push" 2>/dev/null || true)
      if [ -n "$candidate" ] && mkdir -p "$candidate" 2>/dev/null; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
    for candidate in "/c/tmp/torque-pre-push" "${TMPDIR:-/tmp}/torque-pre-push"; do
      if mkdir -p "$candidate" 2>/dev/null; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
  fi

  printf '%s\n' "${TMPDIR:-/tmp}"
}

local_gate_path_for_env() {
  local candidate="$1"
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$candidate" 2>/dev/null || printf '%s\n' "$candidate"
  else
    printf '%s\n' "$candidate"
  fi
}

local_gate_env_assignments() {
  local lane_root="${local_gate_lane_root:-$local_gate_worktree_parent/lane}"
  local data_dir="$lane_root/data"
  local sandbox_dir="$lane_root/sandbox"
  local temp_dir="$lane_root/tmp"
  local cache_dir="$lane_root/cache"
  local coverage_dir="$lane_root/coverage"
  local playwright_dir="$lane_root/playwright"
  local artifacts_dir="$lane_root/artifacts"
  local mcp_artifacts_dir="$artifacts_dir/mcp"
  local vitest_template_dir="$lane_root/vitest-template"
  local vitest_worker_root="$lane_root/vitest-workers"
  local logs_dir="$lane_root/logs"
  mkdir -p "$data_dir" "$sandbox_dir" "$temp_dir" "$cache_dir" "$coverage_dir" \
    "$playwright_dir" "$artifacts_dir" "$mcp_artifacts_dir" "$vitest_template_dir" \
    "$vitest_worker_root" "$logs_dir"

  local seed="${BASHPID:-$$}"
  local port_base=$((43000 + (seed % 1000) * 20))
  local dashboard_port=$port_base
  local api_port=$((port_base + 1))
  local mcp_sse_port=$((port_base + 2))
  local mcp_gateway_port=$((port_base + 3))
  local gpu_metrics_port=$((port_base + 4))
  local coord_port=$((port_base + 5))
  local dashboard_dev_port=$((port_base + 6))

  local lane_root_env data_dir_env sandbox_dir_env temp_dir_env cache_dir_env
  local coverage_dir_env playwright_dir_env artifacts_dir_env mcp_artifacts_dir_env
  local vitest_template_dir_env vitest_worker_root_env
  lane_root_env=$(local_gate_path_for_env "$lane_root")
  data_dir_env=$(local_gate_path_for_env "$data_dir")
  sandbox_dir_env=$(local_gate_path_for_env "$sandbox_dir")
  temp_dir_env=$(local_gate_path_for_env "$temp_dir")
  cache_dir_env=$(local_gate_path_for_env "$cache_dir")
  coverage_dir_env=$(local_gate_path_for_env "$coverage_dir")
  playwright_dir_env=$(local_gate_path_for_env "$playwright_dir")
  artifacts_dir_env=$(local_gate_path_for_env "$artifacts_dir")
  mcp_artifacts_dir_env=$(local_gate_path_for_env "$mcp_artifacts_dir")
  vitest_template_dir_env=$(local_gate_path_for_env "$vitest_template_dir")
  vitest_worker_root_env=$(local_gate_path_for_env "$vitest_worker_root")

  printf 'TORQUE_TEST_LANE=%q ' "local"
  printf 'TORQUE_TEST_LANE_ROOT=%q ' "$lane_root_env"
  printf 'TORQUE_TEST_LANE_DIR=%q ' "$lane_root_env"
  printf 'TORQUE_DATA_DIR=%q ' "$data_dir_env"
  printf 'TORQUE_TEST_SANDBOX=%q ' "1"
  printf 'TORQUE_TEST_SANDBOX_DIR=%q ' "$sandbox_dir_env"
  printf 'TORQUE_VITEST_TEMPLATE_DIR=%q ' "$vitest_template_dir_env"
  printf 'TORQUE_VITEST_WORKER_ROOT=%q ' "$vitest_worker_root_env"
  printf 'TORQUE_DASHBOARD_PORT=%q ' "$dashboard_port"
  printf 'TORQUE_API_PORT=%q ' "$api_port"
  printf 'TORQUE_API_URL=%q ' ""
  printf 'TORQUE_MCP_SSE_PORT=%q ' "$mcp_sse_port"
  printf 'TORQUE_MCP_GATEWAY_PORT=%q ' "$mcp_gateway_port"
  printf 'TORQUE_MCP_GATEWAY_URL=%q ' "http://127.0.0.1:$mcp_gateway_port"
  printf 'TORQUE_GPU_METRICS_PORT=%q ' "$gpu_metrics_port"
  printf 'TORQUE_COORD_HOST=%q ' "127.0.0.1"
  printf 'TORQUE_COORD_PORT=%q ' "$coord_port"
  printf 'TORQUE_DASHBOARD_DEV_PORT=%q ' "$dashboard_dev_port"
  printf 'TORQUE_DASHBOARD_PROXY_TARGET=%q ' "http://127.0.0.1:$dashboard_port"
  printf 'TORQUE_ARTIFACT_DIR=%q ' "$artifacts_dir_env"
  printf 'TORQUE_MCP_ARTIFACT_DIR=%q ' "$mcp_artifacts_dir_env"
  printf 'TORQUE_MCP_LAUNCH_REPORT=%q ' "$mcp_artifacts_dir_env/launch-readiness.json"
  printf 'TORQUE_MCP_DUAL_AGENT_REPORT=%q ' "$mcp_artifacts_dir_env/dual-agent-validation.json"
  printf 'TORQUE_VITEST_COVERAGE_DIR=%q ' "$coverage_dir_env"
  printf 'TORQUE_COVERAGE_DIR=%q ' "$coverage_dir_env"
  printf 'PLAYWRIGHT_OUTPUT_DIR=%q ' "$playwright_dir_env"
  printf 'npm_config_cache=%q ' "$cache_dir_env/npm"
  printf 'TMP=%q ' "$temp_dir_env"
  printf 'TEMP=%q ' "$temp_dir_env"
  printf 'TMPDIR=%q ' "$temp_dir_env"
}

run_local_gate() {
  local gate_cmd="$1"
  local worktree_q base_q gate_script_q lock_root_q lock_env_reset local_gate_env
  prepare_local_gate_worktree
  printf '%s\n' "$gate_cmd" > "$local_gate_script"
  worktree_q=$(printf '%q' "$local_gate_worktree")
  base_q=$(printf '%q' "$REPO_ROOT")
  gate_script_q=$(printf '%q' "$local_gate_script")
  lock_root_q=$(printf '%q' "$local_gate_worktree_parent/coord-locks")
  lock_env_reset=$(coord_lock_env_reset_cmd)
  local_gate_env=$(local_gate_env_assignments)
  # Local gates must not use the SSH tail-by-pid capture wrapper. The Node tee
  # runner waits for child close/stdio EOF before cleanup can remove the gate
  # worktree, which keeps local retries single-owned when the remote is down.
  # Materialize the generated gate body too, avoiding a huge nested bash -c
  # payload through Windows quoting and command-length boundaries.
  run_with_flake_retry_streaming "Local gate" "cd $worktree_q && $lock_env_reset TORQUE_COORD_LOCK_ROOT=$lock_root_q TORQUE_REMOTE_TRANSPORT=local TORQUE_REMOTE_PROJECT_PATH=$worktree_q TORQUE_REMOTE_BASE_PROJECT_PATH=$base_q $local_gate_env bash $gate_script_q"
}

gate_failed() {
  local label="$1"
  pre_push_gate_failure_reason="$label"
  echo "[pre-push] BLOCKED: $label"
  echo "[pre-push] origin/main is unchanged; your local commits are untouched."
  exit 1
}

remote_main_sha=""
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  remote_main_sha=$(git rev-parse origin/main)
fi

if ! gate_plan_output=$(node "$REPO_ROOT/scripts/pre-push-gate-plan.js" --base "$remote_main_sha" --head "$local_head_sha" --format shell); then
  echo "[pre-push] Gate planner failed; falling back to the full gate."
  GATE_MODE="full"
  GATE_PLAN_HASH="fallback-$(echo "$local_head_sha" | cut -c1-12)"
  GATE_COORD_SUITE="gate-full-$GATE_PLAN_HASH"
  GATE_PLAN_SUMMARY="full: planner failed"
  GATE_CHANGED_COUNT="unknown"
  GATE_RUN_DASHBOARD="1"
  GATE_RUN_SERVER="1"
  GATE_RUN_PERF="1"
  GATE_RUN_AUDIT="1"
  GATE_AUDIT_STRICT="1"
  GATE_DASHBOARD_TEST_ARGS=""
  GATE_SERVER_TEST_ARGS=""
else
  eval "$gate_plan_output"
fi

if [ "${PRE_PUSH_FORCE_FULL:-0}" = "1" ] || [ "${PRE_PUSH_GATE_MODE:-}" = "full" ]; then
  GATE_MODE="full"
  GATE_PLAN_HASH="forced-$(echo "$local_head_sha" | cut -c1-12)"
  GATE_COORD_SUITE="gate-full-$GATE_PLAN_HASH"
  GATE_PLAN_SUMMARY="full: forced by PRE_PUSH_FORCE_FULL/PRE_PUSH_GATE_MODE"
  GATE_RUN_DASHBOARD="1"
  GATE_RUN_SERVER="1"
  GATE_RUN_PERF="1"
  GATE_RUN_AUDIT="1"
  GATE_AUDIT_STRICT="1"
  GATE_DASHBOARD_TEST_ARGS=""
  GATE_SERVER_TEST_ARGS=""
fi

# Older gate plans (or external callers eval'ing a stale plan) may not set
# GATE_AUDIT_STRICT. Default it to "0" so the audit invocation below stays
# conservative (warn-only) when the plan didn't opt in.
GATE_AUDIT_STRICT="${GATE_AUDIT_STRICT:-0}"

pre_push_set_gate_phase "planned" "$GATE_PLAN_SUMMARY"
echo "[pre-push] Gate plan: $GATE_PLAN_SUMMARY"
echo "[pre-push] Gate phases: dashboard=$GATE_RUN_DASHBOARD server=$GATE_RUN_SERVER perf=$GATE_RUN_PERF audit=$GATE_RUN_AUDIT(strict=$GATE_AUDIT_STRICT) suite=$GATE_COORD_SUITE"

# Opt-in vitest sharding of the server phase. When TORQUE_GATE_SHARDS=N (N>=2),
# the inline remote gate script runs N concurrent `npx vitest --shard=K/N`
# processes inside one lane workspace, with VITEST_MAX_WORKERS reduced per
# shard so total worker count stays at or below the configured cap. Default
# behaviour (single vitest invocation, 8 workers) is preserved when unset or
# set to 1.
GATE_SERVER_SHARDS="${TORQUE_GATE_SHARDS:-1}"
if ! [[ "$GATE_SERVER_SHARDS" =~ ^[0-9]+$ ]] || [ "$GATE_SERVER_SHARDS" -lt 1 ]; then
  echo "[pre-push] TORQUE_GATE_SHARDS=$GATE_SERVER_SHARDS is not a positive integer; defaulting to 1"
  GATE_SERVER_SHARDS=1
fi

cap_gate_server_shards_for_targeted_tests() {
  if [ "$GATE_RUN_SERVER" != "1" ] || [ "$GATE_SERVER_SHARDS" -le 1 ]; then
    return 0
  fi
  if [ -z "${GATE_SERVER_TEST_ARGS:-}" ]; then
    return 0
  fi

  # The planner emits SAFE_PATH-filtered, space-free, shell-quoted test paths.
  # Counting the expanded words is enough to keep Vitest's --shard denominator
  # within the selected file count without changing the actual argv later.
  set -- $GATE_SERVER_TEST_ARGS
  local target_count="$#"
  if [ "$target_count" -gt 0 ] && [ "$GATE_SERVER_SHARDS" -gt "$target_count" ]; then
    echo "[pre-push] Server phase sharding capped to $target_count targeted test file(s) (requested $GATE_SERVER_SHARDS)."
    GATE_SERVER_SHARDS="$target_count"
  fi
}

cap_gate_server_shards_for_targeted_tests

if [ "$GATE_SERVER_SHARDS" -gt 1 ]; then
  echo "[pre-push] Server phase sharding requested: $GATE_SERVER_SHARDS parallel shards (TORQUE_GATE_SHARDS)"
fi

if [ "$GATE_RUN_DASHBOARD" = "1" ] || [ "$GATE_RUN_SERVER" = "1" ] || [ "$GATE_RUN_PERF" = "1" ]; then
  # Disposable ref under refs/heads/pre-push-gate/. Includes the local sha plus
  # a per-hook-run suffix so an older failed hook's EXIT cleanup cannot delete a
  # newer attempt for the same HEAD while the newer remote sync is still fetching.
  hook_run_id="$(date +%s 2>/dev/null || echo time)-$$"
  staging_branch="pre-push-gate/${local_head_short}-$hook_run_id"
  remote_gate_worktree_suffix="${PRE_PUSH_REMOTE_GATE_WORKTREE_SUFFIX--pre-push-gate}"
  if [ -n "$remote_gate_worktree_suffix" ]; then
    case "$remote_gate_worktree_suffix" in
      *[!A-Za-z0-9_.-]*)
        pre_push_gate_failure_reason="unsafe PRE_PUSH_REMOTE_GATE_WORKTREE_SUFFIX"
        echo "[pre-push] BLOCKED: PRE_PUSH_REMOTE_GATE_WORKTREE_SUFFIX contains unsafe characters."
        exit 1
        ;;
    esac
  fi

  remote_gate_available=1
  if [ "${PRE_PUSH_REMOTE_PREFLIGHT:-1}" != "0" ]; then
    pre_push_set_gate_phase "remote_preflight" "probing torque-remote availability"
    if remote_probe_output=$("$TORQUE_REMOTE_BIN" --__internal-probe-remote-availability 2>&1); then
      remote_probe_reason="$(printf '%s\n' "$remote_probe_output" | tail -n 1)"
      echo "[pre-push] Remote gate preflight: ${remote_probe_reason:-available}"
    else
      remote_gate_available=0
      remote_probe_reason="$(printf '%s\n' "$remote_probe_output" | tail -n 1)"
      remote_gate_fallback_reason="remote_preflight_unavailable"
      echo "[pre-push] Remote gate unavailable before staging (${remote_probe_reason:-probe failed}); running the gate locally instead."
    fi
  else
    echo "[pre-push] Remote gate preflight disabled by PRE_PUSH_REMOTE_PREFLIGHT=0."
  fi

  if [ "$remote_gate_available" -eq 1 ]; then
    pre_push_set_gate_phase "staging" "pushing origin/$staging_branch"
    echo "[pre-push] Staging HEAD at origin/$staging_branch for remote gate..."
    # --force so repeated pushes of the same branch name (rare but possible on
    # force-push of main) overwrite the stale staging ref. The stale ref is still
    # cleaned up by the EXIT trap.
    if git push --no-verify --force origin "$local_head_sha:refs/heads/$staging_branch"; then
      staging_ref_created=1
    else
      remote_gate_fallback_reason="staging_ref_push_failed"
      echo "[pre-push] warn: failed to stage HEAD at origin/$staging_branch; running the gate locally instead."
    fi
  fi

  if [ "$staging_ref_created" -eq 1 ]; then
    pre_push_set_gate_phase "remote_gate" "running selected phases on $staging_branch"
    pre_push_gate_execution_mode="remote"
    echo "[pre-push] Running selected remote gate phases on $staging_branch..."
    # Test phases run in parallel inside one torque-remote SSH session. Perf
    # runs after tests in that same synced checkout so measurements are not
    # contaminated by concurrent vitest load, while avoiding the old second
    # torque-remote sync. The coordinator suite includes the gate-plan hash so
    # warm reruns replay only when the same SHA ran the same phase set.
    cd "$REPO_ROOT"
    export TORQUE_REMOTE_COORD_SHA="$local_head_sha"
    if [ -n "$remote_gate_worktree_suffix" ]; then
      export TORQUE_REMOTE_TEST_WORKTREE_SUFFIX="$remote_gate_worktree_suffix"
      echo "[pre-push] Remote gate checkout suffix: $TORQUE_REMOTE_TEST_WORKTREE_SUFFIX"
    else
      unset TORQUE_REMOTE_TEST_WORKTREE_SUFFIX
      echo "[pre-push] Remote gate checkout suffix disabled; using default torque-remote checkout."
    fi
  else
    if [ -n "$remote_gate_fallback_reason" ]; then
      pre_push_gate_execution_mode="local_fallback"
    else
      pre_push_gate_execution_mode="local"
    fi
    pre_push_set_gate_phase "local_gate" "running selected phases at $local_head_short"
    cd "$REPO_ROOT"
    export TORQUE_REMOTE_COORD_SHA="$local_head_sha"
    unset TORQUE_REMOTE_TEST_WORKTREE_SUFFIX
    echo "[pre-push] Running selected local gate phases at $local_head_sha..."
  fi
remote_gate_cmd=$(cat <<EOF
set -uo pipefail
GATE_SERVER_SHARDS="$GATE_SERVER_SHARDS"
GATE_COORD_LOCK_ROOT="\${TORQUE_GATE_COORD_LOCK_ROOT:-}"
GATE_COORD_LOCK_ROOT_CREATED=0
if [ -z "\$GATE_COORD_LOCK_ROOT" ]; then
  GATE_COORD_LOCK_ROOT="\$(mktemp -d "\${TMPDIR:-/tmp}/pre-push-gate-locks.XXXXXX")"
  GATE_COORD_LOCK_ROOT_CREATED=1
fi
export TORQUE_COORD_LOCK_ROOT="\$GATE_COORD_LOCK_ROOT"
unset TORQUE_COORD_LOCK_DIR TORQUE_COORD_LOCK_TOKEN TORQUE_COORD_LOCK_NAME TORQUE_COORD_LOCK_OWNER_BASHPID
unset REPO_COORD_LOCK_DIR REPO_COORD_LOCK_TOKEN REPO_COORD_LOCK_NAME REPO_COORD_LOCK_REUSED REPO_COORD_LOCK_OWNER_BASHPID REPO_COORD_LOCK_FORCE_RELEASE
cleanup_gate_coord_lock_root() {
  if [ "\${GATE_COORD_LOCK_ROOT_CREATED:-0}" = "1" ] && [ -n "\${GATE_COORD_LOCK_ROOT:-}" ]; then
    rm -rf "\$GATE_COORD_LOCK_ROOT" >/dev/null 2>&1 || true
  fi
}
trap cleanup_gate_coord_lock_root EXIT
DASH_EXIT_FILE=\$(mktemp)
SERV_EXIT_FILE=\$(mktemp)
PERF_EXIT_FILE=\$(mktemp)
DASH_PID=""
SERV_PID=""
SETUP_EXIT=0
SETUP_FAILED_PHASE=""
# Detect the OS on the remote so linking code can branch correctly.
REMOTE_GATE_OS="linux"
if command -v cygpath >/dev/null 2>&1 || [ -n "\${MSYSTEM:-}" ] || [ -n "\${WINDIR:-}" ]; then
  REMOTE_GATE_OS="windows"
fi

remote_path_to_unix() {
  local path="\$1"
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -u "\$path" 2>/dev/null || printf '%s\n' "\$path"
  else
    printf '%s\n' "\$path"
  fi
}

remote_path_to_windows() {
  local path="\$1"
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "\$path" 2>/dev/null || printf '%s\n' "\$path"
  else
    printf '%s\n' "\$path"
  fi
}

gate_now_ms() {
  node -e 'process.stdout.write(String(Date.now()))' 2>/dev/null || {
    local seconds
    seconds=\$(date +%s 2>/dev/null || echo 0)
    printf '%s000\n' "\$seconds"
  }
}

elapsed_ms() {
  local start="\$1"
  local end="\$2"
  case "\$start:\$end" in
    *[!0-9:]*|:*|*:) printf 'unknown\n' ;;
    *) printf '%s\n' "\$((end - start))" ;;
  esac
}

prepend_node_modules() {
  local modules_dir="\$1"
  if [ -d "\$modules_dir" ]; then
    modules_dir="\$(cd "\$modules_dir" && pwd -P)"
  fi
  export PATH="\$modules_dir/.bin:\$PATH"
  if [ -n "\${NODE_PATH:-}" ]; then
    export NODE_PATH="\$modules_dir:\$NODE_PATH"
  else
    export NODE_PATH="\$modules_dir"
  fi
}

dependency_tree_ok() {
  local dir="\$1"
  [ -d "\$dir/node_modules" ] || return 1
  [ -e "\$dir/node_modules/.bin/vitest" ] || [ -e "\$dir/node_modules/vitest/vitest.mjs" ] || return 1
  [ -d "\$dir/node_modules/@vitest/utils" ] || return 1
  case "\$dir" in
    server|*/server)
      [ -d "\$dir/node_modules/better-sqlite3" ] && \
        [ -d "\$dir/node_modules/web-tree-sitter" ] && \
        [ -d "\$dir/node_modules/tree-sitter-wasms" ] && \
        [ -f "\$dir/node_modules/jsdom/lib/jsdom/living/css/helpers/patched-csstree.js" ] && \
        [ -f "\$dir/node_modules/@csstools/css-syntax-patches-for-csstree/dist/index.json" ]
      ;;
    *)
      return 0
      ;;
  esac
}

reuse_base_node_modules() {
  local phase="\$1"
  local dir="\$2"
  local base_project_path="\${TORQUE_REMOTE_BASE_PROJECT_PATH:-}"
  local base_project_dir current_project_dir base_dir base_modules stale_dir target_win base_win
  if [ -z "\$base_project_path" ]; then
    return 1
  fi

  base_project_dir="\$(remote_path_to_unix "\$base_project_path")"
  current_project_dir="\$(pwd -P)"
  if [ "\$base_project_dir" = "\$current_project_dir" ]; then
    return 1
  fi

  base_dir="\$base_project_dir/\$dir"
  base_modules="\$base_dir/node_modules"
  if ! dependency_tree_ok "\$base_dir"; then
    return 1
  fi

  if [ -e "\$dir/node_modules" ] && ! dependency_tree_ok "\$dir"; then
    stale_dir="\$dir/.node_modules-invalid-\$(date +%s 2>/dev/null || echo time)-\$\$"
    if timeout 20 mv "\$dir/node_modules" "\$stale_dir" 2>/dev/null; then
      echo "[\$phase] [setup] moved invalid \$dir/node_modules aside"
    else
      echo "[\$phase] [setup] could not move invalid \$dir/node_modules quickly; installing local dependencies"
    fi
  fi

  if [ ! -e "\$dir/node_modules" ]; then
    if [ "\$REMOTE_GATE_OS" = "windows" ]; then
      target_win="\$(remote_path_to_windows "\$dir/node_modules")"
      base_win="\$(remote_path_to_windows "\$base_modules")"
      if ! MSYS2_ARG_CONV_EXCL="*" cmd.exe /C mklink /D "\$target_win" "\$base_win" >/dev/null 2>&1; then
        if ! powershell.exe -NoProfile -Command "New-Item -ItemType SymbolicLink -Path '\$target_win' -Target '\$base_win' -ErrorAction Stop | Out-Null" >/dev/null 2>&1; then
          if ! MSYS2_ARG_CONV_EXCL="*" cmd.exe /C mklink /J "\$target_win" "\$base_win" >/dev/null 2>&1; then
            echo "[\$phase] [setup] could not create a safe link for \$dir/node_modules quickly; installing local dependencies"
            return 1
          fi
        fi
      fi
    else
      if ! ln -s "\$base_modules" "\$dir/node_modules" 2>/dev/null; then
        echo "[\$phase] [setup] could not create a safe link for \$dir/node_modules quickly; installing local dependencies"
        return 1
      fi
    fi
  fi

  if dependency_tree_ok "\$dir"; then
    prepend_node_modules "\$dir/node_modules"
    echo "[\$phase] [setup] using \$dir dependencies from safe base symlink"
    return 0
  fi

  echo "[\$phase] [setup] could not verify \$dir dependencies through safe base link; installing local dependencies"
  return 1
}

ensure_node_modules() {
  local phase="\$1"
  local dir="\$2"
  local install_reason
  if [ ! -f "\$dir/package.json" ]; then
    return 0
  fi

  if dependency_tree_ok "\$dir"; then
    prepend_node_modules "\$dir/node_modules"
    return 0
  fi

  if reuse_base_node_modules "\$phase" "\$dir"; then
    return 0
  fi

  install_reason=""
  if [ ! -d "\$dir/node_modules" ]; then
    install_reason="missing node_modules"
  elif ! dependency_tree_ok "\$dir"; then
    install_reason="invalid dependency tree"
  fi

  if [ -n "\$install_reason" ]; then
    echo "[\$phase] [setup] installing \$dir dependencies (\$install_reason)"
    if ! (cd "\$dir" && npm install --include=dev --no-audit --no-fund --prefer-offline) 2>&1 | sed -u "s/^/[\$phase] [setup] /"; then
      return 1
    fi
    if ! dependency_tree_ok "\$dir"; then
      echo "[\$phase] [setup] \$dir dependencies still invalid after install"
      return 1
    fi
    prepend_node_modules "\$dir/node_modules"
  fi
}

run_vitest_phase() {
  local dir="\$1"
  shift
  (
    cd "\$dir" || exit 1
    if [ -f "node_modules/vitest/vitest.mjs" ]; then
      timeout ${PHASE_TIMEOUT_SECS} node node_modules/vitest/vitest.mjs "\$@"
    elif command -v vitest >/dev/null 2>&1; then
      timeout ${PHASE_TIMEOUT_SECS} vitest "\$@"
    else
      timeout ${PHASE_TIMEOUT_SECS} npx vitest "\$@"
    fi
  )
}

strip_gate_progress_prefix() {
  local line="\$1"
  local vitest_dot=\$'\302\267'
  local carriage_return=\$'\r'
  while :; do
    case "\$line" in
      .*) line="\${line#.}" ;;
      "\$vitest_dot"*) line="\${line#"\$vitest_dot"}" ;;
      *) break ;;
    esac
  done
  case "\$line" in
    *"\$carriage_return") line="\${line%"\$carriage_return"}" ;;
  esac
  while :; do
    case "\$line" in
      *"\$vitest_dot") line="\${line%"\$vitest_dot"}" ;;
      *) break ;;
    esac
  done
  printf '%s' "\$line"
}

is_expected_gate_fixture_line() {
  local line="\$1"
  case "\$line" in
    "fatal: not a git repository (or any of the parent directories): .git") return 0 ;;
    "Preparing worktree (new branch '"*) return 0 ;;
    "Preparing worktree (detached HEAD "*) return 0 ;;
    "Already on '"*) return 0 ;;
    "Switched to "*) return 0 ;;
    "hint:"|"hint: "*) return 0 ;;
    "Unhandled API error: boom") return 0 ;;
    "Dashboard API error: Invalid JSON body") return 0 ;;
    "Dashboard API error: Request body too large") return 0 ;;
    "[plugin-loader] Failed to load plugin \"auth\" from "*"nonexistent-plugins"*) return 0 ;;
    "Require stack:"*) return 0 ;;
    "- "*"nonexistent-plugins"*) return 0 ;;
    "[data-dir] Could not persist migration-done flag (non-fatal): no such table: config") return 0 ;;
    "Tip: Include file names and specific details for better results.") return 0 ;;
    "err msg") return 0 ;;
  esac
  return 1
}

is_expected_gate_cmd_fixture_line() {
  local line="\$1"
  case "\$line" in
    "'Get-Content' is not recognized as an internal or external command,") return 0 ;;
    "'Get-ChildItem' is not recognized as an internal or external command,") return 0 ;;
    "'Select-String' is not recognized as an internal or external command,") return 0 ;;
    "'Measure-Object' is not recognized as an internal or external command,") return 0 ;;
    "'get-content' is not recognized as an internal or external command,") return 0 ;;
    "'gci' is not recognized as an internal or external command,") return 0 ;;
  esac
  return 1
}

prefix_gate_phase_output() {
  local phase="\$1"
  local line normalized_line cmd_fixture_continuation=0
  while IFS= read -r line || [ -n "\$line" ]; do
    normalized_line="\$(strip_gate_progress_prefix "\$line")"
    case "\$normalized_line" in
      "[gate-timing]"*)
        printf '%s\n' "\$normalized_line"
        continue
        ;;
    esac

    if [ "\$cmd_fixture_continuation" -eq 1 ] && [ "\$normalized_line" = "operable program or batch file." ]; then
      printf '[%s] [expected-test-output] %s\n' "\$phase" "\$normalized_line"
      cmd_fixture_continuation=0
      continue
    fi
    cmd_fixture_continuation=0

    if is_expected_gate_cmd_fixture_line "\$normalized_line"; then
      printf '[%s] [expected-test-output] %s\n' "\$phase" "\$normalized_line"
      cmd_fixture_continuation=1
    elif is_expected_gate_fixture_line "\$normalized_line"; then
      printf '[%s] [expected-test-output] %s\n' "\$phase" "\$normalized_line"
    else
      printf '[%s] %s\n' "\$phase" "\$line"
    fi
  done
}

is_local_gate_transport() {
  case "\${TORQUE_REMOTE_TRANSPORT:-ssh}" in
    local|local-fallback) return 0 ;;
    *) return 1 ;;
  esac
}

configure_local_gate_worker_cap() {
  if ! is_local_gate_transport; then
    return 0
  fi
  if [ "$GATE_RUN_DASHBOARD" != "1" ] && [ "$GATE_RUN_SERVER" != "1" ]; then
    return 0
  fi
  if [ -n "\${VITEST_MAX_WORKERS:-}" ]; then
    echo "[gate] [setup] preserving VITEST_MAX_WORKERS=\$VITEST_MAX_WORKERS for local gate"
    return 0
  fi

  local worker_cap="\${PRE_PUSH_LOCAL_VITEST_MAX_WORKERS:-2}"
  case "\$worker_cap" in
    ''|*[!0-9]*|0)
      echo "[gate] [setup] invalid PRE_PUSH_LOCAL_VITEST_MAX_WORKERS=\$worker_cap; using 2"
      worker_cap=2
      ;;
  esac

  export VITEST_MAX_WORKERS="\$worker_cap"
  echo "[gate] [setup] local gate defaulting VITEST_MAX_WORKERS=\$VITEST_MAX_WORKERS"
}

configure_local_gate_server_shards() {
  if ! is_local_gate_transport; then
    return 0
  fi
  if [ "$GATE_RUN_SERVER" != "1" ]; then
    return 0
  fi
  if [ "\$GATE_SERVER_SHARDS" -le 1 ]; then
    return 0
  fi

  local local_shards="\${PRE_PUSH_LOCAL_GATE_SHARDS:-1}"
  case "\$local_shards" in
    ''|*[!0-9]*|0)
      echo "[serv] [setup] invalid PRE_PUSH_LOCAL_GATE_SHARDS=\$local_shards; using 1"
      local_shards=1
      ;;
  esac

  if [ "\$local_shards" -ne "\$GATE_SERVER_SHARDS" ]; then
    echo "[serv] [setup] local gate using \$local_shards server shard(s) instead of \$GATE_SERVER_SHARDS"
  fi
  GATE_SERVER_SHARDS="\$local_shards"
}

configure_gate_import_perf_threshold() {
  if [ -n "\${PERF_TEST_IMPORT_FAIL_MS:-}" ]; then
    echo "[gate] [setup] preserving PERF_TEST_IMPORT_FAIL_MS=\$PERF_TEST_IMPORT_FAIL_MS"
    export PERF_TEST_IMPORT_FAIL_MS
    return 0
  fi

  local threshold="\${PRE_PUSH_PERF_TEST_IMPORT_FAIL_MS:-6000}"
  case "\$threshold" in
    ''|*[!0-9]*|0)
      echo "[gate] [setup] invalid PRE_PUSH_PERF_TEST_IMPORT_FAIL_MS=\$threshold; using 6000"
      threshold=6000
      ;;
  esac

  export PERF_TEST_IMPORT_FAIL_MS="\$threshold"
  echo "[gate] [setup] defaulting PERF_TEST_IMPORT_FAIL_MS=\$PERF_TEST_IMPORT_FAIL_MS for pre-push gate"
}

# Phase exit files are the source of truth; output-prefix pipelines are
# observational and must not suppress the final gate-end marker under pipefail.
run_dashboard_phase() {
  {
    PHASE_START_MS=\$(gate_now_ms)
    run_vitest_phase dashboard run --reporter=dot ${GATE_DASHBOARD_TEST_ARGS}
    PHASE_EXIT=\$?
    PHASE_END_MS=\$(gate_now_ms)
    echo "[gate-timing] dash_ms=\$(elapsed_ms "\$PHASE_START_MS" "\$PHASE_END_MS") exit=\$PHASE_EXIT"
    echo \$PHASE_EXIT > "\$DASH_EXIT_FILE"
  } 2>&1 | prefix_gate_phase_output dash || true
}

# Vitest sharding (opt-in via dev-side TORQUE_GATE_SHARDS). When sharding is
# active, run_server_phase spawns N concurrent vitest --shard=K/N processes
# inside the same lane workspace. Each shard runs a disjoint slice of files.
# Per-shard VITEST_MAX_WORKERS defaults to 1 to keep total concurrent
# workers manageable on the remote workstation, which shares CPU with QEMU,
# ollama, and other tenants — bisection traced "shard hangs after running
# some files" to CPU starvation when 4 × 2 = 8 workers fought ~5 free CPUs.
#
# A side watchdog process polls each shard's per-file log mtime and SIGKILLs
# a shard whose log has been idle for SHARD_WATCHDOG_SECS (default 180).
# Without this, a starved shard's vitest waits forever on its workers and
# the entire gate hangs invisibly until the dev-side SSH timeout fires.
run_server_shards() {
  local n="\$GATE_SERVER_SHARDS"
  local k=0
  local any_failed=0
  local per_shard="\${TORQUE_GATE_PER_SHARD_WORKERS:-1}"
  if [ "\$per_shard" -lt 1 ]; then per_shard=1; fi
  local watchdog_secs="\${TORQUE_GATE_SHARD_WATCHDOG_SECS:-180}"
  echo "[serv] [shards] launching \$n shards, VITEST_MAX_WORKERS=\$per_shard per shard, watchdog=\${watchdog_secs}s"
  local pids=()
  local logs=()
  local watchdog_dir
  watchdog_dir=\$(mktemp -d "\${TMPDIR:-/tmp}/torque-gate-shards.XXXXXX")
  for k in \$(seq 1 \$n); do
    local logfile="\$watchdog_dir/shard-\$k.log"
    : > "\$logfile"
    (
      export VITEST_MAX_WORKERS="\$per_shard"
      run_vitest_phase server run --reporter=dot --shard="\$k/\$n" ${GATE_SERVER_TEST_ARGS} 2>&1 \
        | sed "s/^/[shard\$k] /" \
        | tee -a "\$logfile"
      exit "\${PIPESTATUS[0]}"
    ) &
    pids+=(\$!)
    logs+=("\$logfile")
  done

  # Background watchdog — every 30s, check whether each shard's log file
  # has grown. If a shard has been idle longer than \$watchdog_secs while
  # its pid is still alive, SIGKILL the shard subshell tree and record
  # the kill so the gate fails loudly instead of waiting on a hung
  # vitest. Watchdog exits when every shard pid has exited.
  local shard_count=\${#pids[@]}
  (
    while :; do
      sleep 30
      local any_alive=0
      local i
      for i in \$(seq 0 \$((shard_count - 1))); do
        local pid="\${pids[\$i]}"
        local log="\${logs[\$i]}"
        if kill -0 "\$pid" 2>/dev/null; then
          any_alive=1
          local mtime now idle
          mtime=\$(stat -c %Y "\$log" 2>/dev/null || echo 0)
          now=\$(date +%s)
          idle=\$((now - mtime))
          if [ "\$idle" -gt "\$watchdog_secs" ]; then
            local sk=\$((i + 1))
            echo "[serv] [shards] [watchdog] shard\$sk idle for \${idle}s — SIGKILL (likely resource starvation)" >&2
            pkill -9 -P "\$pid" 2>/dev/null || true
            kill -9 "\$pid" 2>/dev/null || true
          fi
        fi
      done
      [ "\$any_alive" = 0 ] && break
    done
  ) &
  local watchdog_pid=\$!

  for pid in "\${pids[@]}"; do
    if ! wait "\$pid"; then any_failed=1; fi
  done
  # Watchdog exits on its own when all shards are dead; reap it without
  # error if it raced ahead.
  kill "\$watchdog_pid" 2>/dev/null || true
  wait "\$watchdog_pid" 2>/dev/null || true
  rm -rf "\$watchdog_dir" 2>/dev/null || true
  return \$any_failed
}

run_server_phase() {
  {
    PHASE_START_MS=\$(gate_now_ms)
    if [ "\$GATE_SERVER_SHARDS" -gt 1 ]; then
      run_server_shards
    else
      run_vitest_phase server run --reporter=dot ${GATE_SERVER_TEST_ARGS}
    fi
    PHASE_EXIT=\$?
    PHASE_END_MS=\$(gate_now_ms)
    echo "[gate-timing] serv_ms=\$(elapsed_ms "\$PHASE_START_MS" "\$PHASE_END_MS") exit=\$PHASE_EXIT shards=\$GATE_SERVER_SHARDS"
    echo \$PHASE_EXIT > "\$SERV_EXIT_FILE"
  } 2>&1 | prefix_gate_phase_output serv || true
}

# Sweep stale torque-* test temp dirs from \$TMPDIR. Each test that
# uses TORQUE_DATA_DIR creates an mkdtempSync() dir; tests don't always
# clean up (vitest crashes, SSH drops kill afterAll). Without this,
# the dir count grows without bound and NTFS performance degrades --
# observed 23579 accumulated dirs slowing server tests from ~5min to
# >30min (timeout). Cap is 60 min: anything older is orphan.
sweep_stale_torque_temp_dirs() {
  local tmp_dir="\${TMPDIR:-/tmp}"
  if [ ! -d "\$tmp_dir" ]; then return 0; fi
  local sweep_start sweep_end count_before count_after
  sweep_start=\$(gate_now_ms)
  count_before=\$(find "\$tmp_dir" -maxdepth 1 -name 'torque-*' 2>/dev/null | wc -l || echo 0)
  find "\$tmp_dir" -maxdepth 1 -name 'torque-*' -mmin +60 -prune -exec rm -rf {} + 2>/dev/null || true
  count_after=\$(find "\$tmp_dir" -maxdepth 1 -name 'torque-*' 2>/dev/null | wc -l || echo 0)
  sweep_end=\$(gate_now_ms)
  echo "[gate-timing] temp_sweep_ms=\$(elapsed_ms "\$sweep_start" "\$sweep_end") before=\$count_before after=\$count_after"
}

GATE_START_MS=\$(gate_now_ms)
sweep_stale_torque_temp_dirs
SETUP_START_MS=\$(gate_now_ms)
echo "[gate-timing] remote_start_ms=\$GATE_START_MS mode=$GATE_MODE changed=$GATE_CHANGED_COUNT"

if [ "$GATE_RUN_DASHBOARD" = "1" ]; then
  ensure_node_modules dash dashboard
  SETUP_EXIT=\$?
  if [ "\$SETUP_EXIT" -ne 0 ]; then
    SETUP_FAILED_PHASE="dash"
  fi
fi
if [ "\$SETUP_EXIT" -eq 0 ] && { [ "$GATE_RUN_SERVER" = "1" ] || [ "$GATE_RUN_PERF" = "1" ]; }; then
  ensure_node_modules serv server
  SETUP_EXIT=\$?
  if [ "\$SETUP_EXIT" -ne 0 ]; then
    SETUP_FAILED_PHASE="serv"
  fi
fi
if [ "\$SETUP_EXIT" -ne 0 ]; then
  DASH_SETUP_EXIT=0
  SERV_SETUP_EXIT=0
  case "\$SETUP_FAILED_PHASE" in
    dash) DASH_SETUP_EXIT=\$SETUP_EXIT ;;
    serv) SERV_SETUP_EXIT=\$SETUP_EXIT ;;
    *) DASH_SETUP_EXIT=\$SETUP_EXIT ;;
  esac
  SETUP_END_MS=\$(gate_now_ms)
  echo "[gate-timing] setup_ms=\$(elapsed_ms "\$SETUP_START_MS" "\$SETUP_END_MS") exit=\$SETUP_EXIT failed_phase=\$SETUP_FAILED_PHASE"
  echo "[\$SETUP_FAILED_PHASE] [setup] dependency bootstrap failed exit=\$SETUP_EXIT"
  GATE_END_MS=\$(gate_now_ms)
  echo "[gate-timing] total_ms=\$(elapsed_ms "\$GATE_START_MS" "\$GATE_END_MS") dash_exit=\$DASH_SETUP_EXIT serv_exit=\$SERV_SETUP_EXIT perf_exit=0"
  echo "[gate-end] dash_exit=\$DASH_SETUP_EXIT serv_exit=\$SERV_SETUP_EXIT perf_exit=0"
  rm -f "\$DASH_EXIT_FILE" "\$SERV_EXIT_FILE" "\$PERF_EXIT_FILE"
  exit "\$SETUP_EXIT"
fi

SETUP_END_MS=\$(gate_now_ms)
echo "[gate-timing] setup_ms=\$(elapsed_ms "\$SETUP_START_MS" "\$SETUP_END_MS") exit=0"
configure_gate_import_perf_threshold
configure_local_gate_worker_cap
configure_local_gate_server_shards

if is_local_gate_transport; then
  echo "[gate] local transport detected; running dashboard/server phases sequentially"
  if [ "$GATE_RUN_DASHBOARD" = "1" ]; then
    run_dashboard_phase
  else
    echo 0 > "\$DASH_EXIT_FILE"
    echo "[dash] skipped by gate plan"
    echo "[gate-timing] dash_ms=0 exit=0 skipped=1"
  fi

  if [ "$GATE_RUN_SERVER" = "1" ]; then
    run_server_phase
  else
    echo 0 > "\$SERV_EXIT_FILE"
    echo "[serv] skipped by gate plan"
    echo "[gate-timing] serv_ms=0 exit=0 skipped=1"
  fi
else
  if [ "$GATE_RUN_DASHBOARD" = "1" ]; then
    run_dashboard_phase &
    DASH_PID=\$!
  else
    echo 0 > "\$DASH_EXIT_FILE"
    echo "[dash] skipped by gate plan"
    echo "[gate-timing] dash_ms=0 exit=0 skipped=1"
  fi

  if [ "$GATE_RUN_SERVER" = "1" ]; then
    run_server_phase &
    SERV_PID=\$!
  else
    echo 0 > "\$SERV_EXIT_FILE"
    echo "[serv] skipped by gate plan"
    echo "[gate-timing] serv_ms=0 exit=0 skipped=1"
  fi

  if [ -n "\${DASH_PID:-}" ]; then wait "\$DASH_PID" 2>/dev/null; fi
  if [ -n "\${SERV_PID:-}" ]; then wait "\$SERV_PID" 2>/dev/null; fi
fi
DASH_EXIT=\$(cat "\$DASH_EXIT_FILE" 2>/dev/null || echo "1")
SERV_EXIT=\$(cat "\$SERV_EXIT_FILE" 2>/dev/null || echo "1")

if [ "\$DASH_EXIT" -eq 0 ] && [ "\$SERV_EXIT" -eq 0 ] && [ "$GATE_RUN_PERF" = "1" ]; then
  {
    PHASE_START_MS=\$(gate_now_ms)
    timeout ${PHASE_TIMEOUT_SECS} bash -c "cd server && node perf/run-perf.js"
    PHASE_EXIT=\$?
    PHASE_END_MS=\$(gate_now_ms)
    echo "[gate-timing] perf_ms=\$(elapsed_ms "\$PHASE_START_MS" "\$PHASE_END_MS") exit=\$PHASE_EXIT"
    echo \$PHASE_EXIT > "\$PERF_EXIT_FILE"
  } 2>&1 | prefix_gate_phase_output perf || true
else
  echo 0 > "\$PERF_EXIT_FILE"
  if [ "$GATE_RUN_PERF" != "1" ]; then
    echo "[perf] skipped by gate plan"
  else
    echo "[perf] skipped because a test phase failed"
  fi
  echo "[gate-timing] perf_ms=0 exit=0 skipped=1"
fi

PERF_EXIT=\$(cat "\$PERF_EXIT_FILE" 2>/dev/null || echo "1")
rm -f "\$DASH_EXIT_FILE" "\$SERV_EXIT_FILE" "\$PERF_EXIT_FILE"
GATE_END_MS=\$(gate_now_ms)
echo "[gate-timing] total_ms=\$(elapsed_ms "\$GATE_START_MS" "\$GATE_END_MS") dash_exit=\$DASH_EXIT serv_exit=\$SERV_EXIT perf_exit=\$PERF_EXIT"
echo "[gate-end] dash_exit=\$DASH_EXIT serv_exit=\$SERV_EXIT perf_exit=\$PERF_EXIT"
exit \$((DASH_EXIT + SERV_EXIT + PERF_EXIT))
EOF
)
  if [ "$staging_ref_created" -eq 1 ]; then
    # Pre-push owns the local fallback path so the gate runs once. torque-remote
    # still falls back locally for ad hoc use, but here that can leave a child
    # gate alive while the hook starts its own fallback after a missing marker.
    lock_env_reset=$(coord_lock_env_reset_cmd)
    run_with_flake_retry "Remote gate" "$lock_env_reset TORQUE_REMOTE_REQUIRE_REMOTE=1 $TORQUE_REMOTE_CMD --suite $GATE_COORD_SUITE --branch $staging_branch bash -c $(printf %q "$remote_gate_cmd")"
    if ! extract_gate_end_marker "$RETRIED_OUTPUT" >/dev/null; then
      remote_gate_attempt_exit="$RETRIED_EXIT"
      remote_gate_attempt_output_tail="$(printf '%s\n' "$RETRIED_OUTPUT" | tail -120)"
      remote_gate_fallback_reason="remote_gate_missing_marker"
      pre_push_gate_execution_mode="local_fallback"
      echo "[pre-push] Remote gate did not produce a gate-end marker; running the gate locally instead."
      run_local_gate "$remote_gate_cmd"
    fi
  else
    run_local_gate "$remote_gate_cmd"
  fi
  combined_output="$RETRIED_OUTPUT"
  combined_exit="$RETRIED_EXIT"
  gate_end_marker=""
  pre_push_set_gate_phase "gate_results" "parsing gate completion marker"
  if ! gate_end_marker=$(extract_gate_end_marker "$combined_output"); then
    gate_failed "Gate did not produce completion marker"
  fi

  # Split combined output into per-phase streams for failure analysis.
  dash_output=$(echo "$combined_output" | grep '^\[dash\] ' | sed 's/^\[dash\] //')
  server_output=$(echo "$combined_output" | grep '^\[serv\] ' | sed 's/^\[serv\] //')
  perf_output=$(echo "$combined_output" | grep '^\[perf\] ' | sed 's/^\[perf\] //')

  # The gate-end marker reports per-phase exits even when overall exit code
  # is nonzero from `set -uo pipefail` weirdness. Parse the final anchored
  # marker instead of grepping the whole captured output: torque-remote logs
  # the heredoc body too, and `grep -q` can trip pipefail on large streams.
  gate_exits=""
  if gate_exits=$(parse_gate_end_exits "$gate_end_marker"); then
    set -- $gate_exits
    dash_exit="$1"
    server_exit="$2"
    perf_exit="$3"
  else
    dash_exit="$combined_exit"
    server_exit="$combined_exit"
    perf_exit="$combined_exit"
  fi

  if [ "$dash_exit" -ne 0 ] || tests_have_failures "$dash_output"; then
    print_gate_failure_summary "Dashboard" "$dash_output" "$dash_exit" "$gate_end_marker"
    gate_failed "Dashboard tests failed (exit $dash_exit)"
  fi
  if [ "$server_exit" -ne 0 ] || tests_have_failures "$server_output"; then
    print_gate_failure_summary "Server" "$server_output" "$server_exit" "$gate_end_marker"
    gate_failed "Server tests failed (exit $server_exit)"
  fi
  if [ "$perf_exit" -ne 0 ]; then
    echo "$perf_output" | tail -20
    if [ "${PERF_GATE_BYPASS:-0}" = "1" ]; then
      echo "[pre-push] PERF_GATE_BYPASS=1 set — perf regressions logged but push allowed"
      AUDIT_LINE="[$(date -Iseconds 2>/dev/null || date)] BYPASS sha=$(git rev-parse HEAD) reason=PERF_GATE_BYPASS user=$(git config user.email 2>/dev/null || echo unknown)"
      mkdir -p "$REPO_ROOT/server/perf"
      echo "$AUDIT_LINE" >> "$REPO_ROOT/server/perf/bypass-audit.log"
    else
      pre_push_gate_failure_reason="perf regression gate failed (exit $perf_exit)"
      echo "[pre-push] BLOCKED: perf regression gate failed (exit $perf_exit)"
      echo "[pre-push] To bypass for incident response: PERF_GATE_BYPASS=1 git push"
      exit 1
    fi
  fi
else
  pre_push_set_gate_phase "gate_skipped" "heavy gate skipped by plan"
  echo "[pre-push] Heavy remote gate skipped by gate plan."
fi

# perf-baseline trailer enforcement: any commit in the push that touches
# server/perf/baseline.json must carry a perf-baseline: trailer.
pre_push_set_gate_phase "post_gate_checks" "checking perf baseline trailers"
if [ -n "$remote_main_sha" ]; then
  for sha in $(git rev-list "$remote_main_sha..$local_head_sha" 2>/dev/null); do
    if git show --name-only --format= "$sha" | grep -q '^server/perf/baseline\.json$'; then
      if ! node "$REPO_ROOT/scripts/perf-baseline-trailer.js" "$sha"; then
        pre_push_gate_failure_reason="commit $sha modifies server/perf/baseline.json without a valid perf-baseline trailer"
        echo "[pre-push] BLOCKED: commit $sha modifies server/perf/baseline.json without a valid perf-baseline: trailer"
        exit 1
      fi
    fi
  done
fi

if [ "$GATE_RUN_AUDIT" = "1" ]; then
  pre_push_set_gate_phase "db_audit" "running database query audit"
  if [ "$GATE_AUDIT_STRICT" = "1" ]; then
    echo "Running DB query audit (strict, baseline-aware)..."
    node "$REPO_ROOT/scripts/audit-db-queries.js" --strict
    if [ $? -ne 0 ]; then
      pre_push_gate_failure_reason="strict DB query audit detected new potential full scans"
      echo "ERROR: DB query audit detected NEW potential full-scan(s) in this push."
      echo "       Add @full-scan: <reason>, add an index, or run"
      echo "       'node scripts/audit-db-queries.js --write-baseline' if intentional"
      echo "       and commit the regenerated baseline."
      exit 1
    fi
  else
    echo "Running DB query audit (warn-only, no audited paths in diff)..."
    node "$REPO_ROOT/scripts/audit-db-queries.js"
    if [ $? -ne 0 ]; then
      pre_push_gate_failure_reason="DB query audit failed"
      echo "ERROR: DB query audit failed."
      exit 1
    fi
  fi
else
  echo "[pre-push] DB query audit skipped by gate plan."
fi

pre_push_set_gate_phase "complete" "gate passed; git may push main"
echo "[pre-push] All tests passed — git will now push refs/heads/main."
